# 운영 서버의 환경 변수 틀. 이 파일을 .env.prod로 복사해 값을 채우고 EC2에 올린다
# (./scripts/deploy-server.sh --push-env). .env.prod는 git에 올라가지 않는다.
# 여기 적힌 "필수"가 하나라도 비면 서버가 뜨지 않는다(apps/server/src/config/env.validation.ts).

# ── DB (RDS) · 필수 ─────────────────────────────────────────────────────────
# 끝의 sslmode=require를 빼지 않는다.
DATABASE_URL=postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/estaitflow?sslmode=require

# ── Redis (ElastiCache) ─────────────────────────────────────────────────────
# 전송 암호화를 켰으면 rediss://, 아니면 redis://. 비워 두면 실시간이 서버 한 대 안에서만 돈다.
REDIS_URL=rediss://ELASTICACHE-ENDPOINT:6379

# ── Auth0 · 필수 ────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
# 자체 로그인 주소(쉼표로 여러 개). 이 주소로 로그인해 받은 토큰도 받는다. AUTH0_DOMAIN은 테넌트 도메인 그대로 둔다
AUTH0_CUSTOM_DOMAINS=
# 이 서버의 API 식별자
AUTH0_AUDIENCE=https://api.estaitt.com
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# 운영 테넌트의 데스크톱 앱 client ID (쉼표로 여러 개)
AUTH0_STAFF_CLIENT_IDS=
# Auth0 Action(post-change-password)의 EVENT_SECRET과 같은 값
AUTH0_EVENT_SECRET=

# ── MCP ────────────────────────────────────────────────────────────────────
# 외부 AI에 알리는 MCP 주소(= Auth0 MCP API 식별자). AUTH0_AUDIENCE와 달라야 한다.
MCP_RESOURCE_URL=https://api.estaitt.com/mcp

# ── 계약 당사자 암호화 키 · 필수 ────────────────────────────────────────────
# 계약서의 주민(법인)번호 · 전화번호를 이 키로 암호화한다. 길고 무작위인 문자열(openssl rand -base64 48).
# 한 번 정하면 바꾸지 않는다 — 바꾸거나 잃으면 이미 저장한 값을 풀 수 없다. 따로 안전한 곳에도 보관한다.
CONTRACT_PARTY_CRYPTO_KEY=

# ── 선택 ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# GEMINI_API_KEY=
# PUBLIC_DATA_SERVICE_KEY=
# VWORLD_API_KEY=
# NAVER_MAPS_CLIENT_ID=
# NAVER_MAPS_CLIENT_SECRET=
# RULE_ENGINE_ENABLED=
