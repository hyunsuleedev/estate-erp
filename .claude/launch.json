{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:server"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web"],
      "port": 5173
    },
    {
      "name": "desktop-renderer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@estate-erp/desktop", "exec", "vite", "--config", "vite.renderer.config.ts"],
      "port": 5174
    }
  ]
}
