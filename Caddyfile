# 운영 서버의 HTTPS 입구. 도메인은 EC2의 .env에 적힌 API_DOMAIN(api.estaitt.com 또는 시험용 api-dev.estaitt.com).
# 인증서는 Caddy가 알아서 받고 갱신한다 — 80·443이 열려 있고 DNS가 이 서버의 IP를 가리켜야 한다
# (Cloudflare를 쓰면 프록시를 끈 "DNS only"로).
(estate_backend) {
	reverse_proxy server:3000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	# 탭 아이콘. 외부 AI(Claude 등)가 연결 목록에 이 주소의 아이콘을 쓴다. 파일은 앱 배포 저장소(R2)에 있다.
	handle /favicon.ico {
		rewrite * /brand/favicon.ico
		reverse_proxy https://releases.estaitt.com {
			header_up Host releases.estaitt.com
		}
	}

	@recording_upload {
		method POST
		path_regexp ^/consultations/(with-recording|[^/]+/recording|recordings/[^/]+/attach-file)/?$
	}
	handle @recording_upload {
		# 파일 128MiB와 multipart 헤더·상담 항목
		request_body {
			max_size 129MiB
		}
		import estate_backend
	}

	handle {
		# 외부 매물 배치 업로드(서버 한도 10MB)에 맞춘 본문 크기
		request_body {
			max_size 12MB
		}
		import estate_backend
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
