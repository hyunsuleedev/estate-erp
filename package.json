{
  "name": "estate-erp",
  "version": "0.0.1",
  "private": true,
  "description": "부동산 중개사 전용 SaaS ERP 시스템",
  "engines": {
    "node": ">=23.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract",
      "esbuild",
      "electron",
      "electron-winstaller"
    ]
  },
  "scripts": {
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "infra:ps": "docker compose -f docker-compose.dev.yml ps",
    "dev": "pnpm --parallel --filter @estate-erp/server --filter @estate-erp/desktop dev",
    "dev:server": "pnpm --filter @estate-erp/server dev",
    "dev:desktop": "pnpm --filter @estate-erp/desktop dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @estate-erp/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "prisma:migrate": "pnpm --filter @estate-erp/server prisma:migrate",
    "prisma:reset": "pnpm --filter @estate-erp/server prisma:reset",
    "prisma:seed": "pnpm --filter @estate-erp/server prisma:seed",
    "prisma:generate": "pnpm --filter @estate-erp/server prisma:generate",
    "prisma:studio": "pnpm --filter @estate-erp/server prisma:studio"
  },
  "devDependencies": {
    "prisma": "6.19.2",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@dnd-kit/modifiers": "7.0.0",
    "@prisma/client": "6.19.2"
  }
}
