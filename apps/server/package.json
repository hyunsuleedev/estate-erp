{
  "name": "@estate-erp/server",
  "version": "0.0.1",
  "private": true,
  "description": "Estate ERP NestJS Backend",
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "prisma generate --schema ../../prisma/schema",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema",
    "prisma:reset": "prisma migrate reset --force --skip-seed --schema ../../prisma/schema",
    "prisma:seed": "tsx ../../prisma/seed.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema",
    "prisma:studio": "prisma studio --schema ../../prisma/schema"
  },
  "dependencies": {
    "@estate-erp/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@scalar/nestjs-api-reference": "^1.1.5",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^4.0.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "jest": "^29.0.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.7.0"
  }
}
