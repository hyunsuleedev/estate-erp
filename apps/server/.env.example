# Docker development infra lives at /docker-compose.dev.yml.
# Start it with `pnpm infra:up` before running the server.
# If local PostgreSQL or Redis already use 5432/6379, stop them first.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/estate_erp"
REDIS_URL="redis://127.0.0.1:6379"
RESEND_API_KEY="re_your_api_key"
PORT=3000

# Rule Engine — AI 직원 규칙 엔진 실행 토글
# true 로 두면 @nestjs/schedule 기반 in-process cron 이 동작한다.
# 다중 인스턴스 배포시 하나의 인스턴스에만 true 를 주거나 BullMQ 로 전환해야 한다.
RULE_ENGINE_ENABLED="true"

# Auth0 — ERP 직원(owner/manager/agent) 로그인. 필수.
# AUTH0_DOMAIN: 테넌트 도메인. 이 테넌트가 발급한 접근 토큰만 받는다.
# AUTH0_AUDIENCE: 이 서버의 API 식별자(Auth0 API의 Identifier). 토큰의 aud와 같아야 한다.
# 서버는 토큰의 sub(Auth0 user_id)로 users.auth0_id를 찾는다. 아이디 문자열로는 연결하지 않는다.
AUTH0_DOMAIN="your-tenant.jp.auth0.com"
AUTH0_AUDIENCE="https://api.estaitt.com"
# Auth0 Management API용 M2M 앱 (직원 계정 생성·비밀번호 재설정·차단·삭제, 신규 가입자 확인).
# 필요한 권한: read:users create:users update:users delete:users
#              read:device_credentials delete:device_credentials (refresh token 폐기)
# 관리 토큰은 서버가 메모리에 두고 만료 직전까지 다시 쓴다(무료 요금제 M2M 토큰은 월 1,000개).
AUTH0_MGMT_CLIENT_ID=""
AUTH0_MGMT_CLIENT_SECRET=""
# 직원 계정이 속한 Auth0 DB 연결 이름 (기본값 그대로면 생략 가능)
# AUTH0_DB_CONNECTION="Username-Password-Authentication"

# 직원 REST API를 쓸 수 있는 Auth0 앱의 client ID (토큰의 azp). 쉼표로 여러 개.
# 개발에서 생략하면 시험 테넌트의 데스크톱 앱만 허용한다. 운영(NODE_ENV=production)에서는
# 필수이며 그 테넌트의 데스크톱 앱 client ID를 넣는다. 외부 AI가 등록한 MCP
# 클라이언트는 넣지 않는다. AUTH0_MGMT_* 두 값도 운영에서는 필수다.
# AUTH0_STAFF_CLIENT_IDS=""

# MCP 주소 = Auth0 MCP API의 식별자 (RFC 8707 resource, 토큰의 aud).
# 외부 AI 클라이언트가 접속하는 /mcp의 공개 주소와 글자 그대로 같아야 한다(끝에 / 없음).
# 생략하면 운영 주소 https://api.estaitt.com/mcp 를 쓴다. AUTH0_AUDIENCE와 같으면
# 서버가 뜨지 않는다(MCP 토큰과 직원 REST 토큰을 대상으로 구분하기 때문).
MCP_RESOURCE_URL="http://localhost:3000/mcp"

# Clerk — 소비자 사이트(apps/catalog) 로그인에만 쓴다. 선택.
# 비우면 서버는 뜨고, 소비자 로그인은 503으로 답한다. 직원 로그인과 MCP에는 쓰지 않는다.
CLERK_SECRET_KEY="sk_test_..."

# 공적장부 조회 — 키가 없으면 해당 공급자는 UI에서 설정 필요로 표시된다.
# 공공데이터포털 일반 인증키(Encoding 키도 가능하며 서버에서 한 번만 디코딩)
PUBLIC_DATA_SERVICE_KEY=""
# VWorld 오픈API 인증키와 키 발급 시 등록한 서비스 도메인
VWORLD_API_KEY=""
VWORLD_API_DOMAIN="http://localhost:5173"

# 등기부 자동 발급 공급자 후보: manual | tilko | hyphen | codef | coocon
# 계약/심사와 공급자별 자격증명이 완료되기 전에는 manual을 유지한다.
REGISTRY_PROVIDER="manual"

# Explicit allowed consumer-site origins for Clerk session verification.
CATALOG_AUTH_ORIGINS=http://localhost:5180

# Optional: server-side office address geocoding. Keep the secret off the desktop.
# Kakao Postcode search itself does not need these keys.
NAVER_MAPS_CLIENT_ID=""
NAVER_MAPS_CLIENT_SECRET=""

# 통화 녹음 받아쓰기·분석 (Gemini). 고객 음성이 들어가므로 반드시 유료 등급 키를 쓴다
# (무료 등급은 입력 데이터를 구글이 제품 개선에 사용)
GEMINI_API_KEY=
# 받아쓰기 업체: gemini(기본) / vito / dummy. 비우면 설정된 키를 보고 고른다
STT_PROVIDER=
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# 단어별 시각(구간 재생용). 정확도가 떨어질 수 있어 기본은 끔
# GEMINI_STT_WORD_TIMESTAMPS=false
# VITO_CLIENT_ID=
# VITO_CLIENT_SECRET=
