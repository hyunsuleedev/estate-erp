# Docker development infra lives at /docker-compose.dev.yml.
# Start it with `pnpm infra:up` before running the server.
# If local PostgreSQL or Redis already use 5432/6379, stop them first.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/estate_erp"
REDIS_URL="redis://127.0.0.1:6379"
RESEND_API_KEY="re_your_api_key"
PORT=3000

# Rule Engine — AI 직원 규칙 엔진 실행 토글
# true 로 두면 @nestjs/schedule 기반 in-process cron 이 동작한다.
# 다중 인스턴스 배포시 하나의 인스턴스에만 true 를 주거나 BullMQ 로 전환해야 한다.
RULE_ENGINE_ENABLED="true"

# Clerk Auth
# Server-side secret key used to verify Clerk session tokens and fetch user
# emails during first-login auto-linking.
CLERK_SECRET_KEY="sk_test_..."
# Clerk Frontend API / OAuth authorization server advertised to MCP clients.
# Example: https://useful-dolphin-37.clerk.accounts.dev
CLERK_OAUTH_AUTHORIZATION_SERVER="https://your-instance.clerk.accounts.dev"

# MCP audience (RFC 8707 Resource Indicators)
# Phase 1엔 자체 JWT로 MCP 처리 (이미 구현됨), Phase 1.5+에 OAuth 정식
MCP_AUDIENCE="http://localhost:3000/mcp"

# 공적장부 조회 — 키가 없으면 해당 공급자는 UI에서 설정 필요로 표시된다.
# 공공데이터포털 일반 인증키(Encoding 키도 가능하며 서버에서 한 번만 디코딩)
PUBLIC_DATA_SERVICE_KEY=""
# VWorld 오픈API 인증키와 키 발급 시 등록한 서비스 도메인
VWORLD_API_KEY=""
VWORLD_API_DOMAIN="http://localhost:5173"

# 등기부 자동 발급 공급자 후보: manual | tilko | hyphen | codef | coocon
# 계약/심사와 공급자별 자격증명이 완료되기 전에는 manual을 유지한다.
REGISTRY_PROVIDER="manual"

# Explicit allowed consumer-site origins for Clerk session verification.
CATALOG_AUTH_ORIGINS=http://localhost:5180

# Optional: server-side office address geocoding. Keep the secret off the desktop.
# Kakao Postcode search itself does not need these keys.
NAVER_MAPS_CLIENT_ID=""
NAVER_MAPS_CLIENT_SECRET=""

# 통화 녹음 받아쓰기·분석 (Gemini). 고객 음성이 들어가므로 반드시 유료 등급 키를 쓴다
# (무료 등급은 입력 데이터를 구글이 제품 개선에 사용)
GEMINI_API_KEY=
# 받아쓰기 업체: gemini(기본) / vito / dummy. 비우면 설정된 키를 보고 고른다
STT_PROVIDER=
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# 단어별 시각(구간 재생용). 정확도가 떨어질 수 있어 기본은 끔
# GEMINI_STT_WORD_TIMESTAMPS=false
# VITO_CLIENT_ID=
# VITO_CLIENT_SECRET=

# Auth0 (데스크톱 Auth0 시험 모드)
# 설정하면 발급자가 이 테넌트인 접근 토큰을 Auth0로 검증하고, 토큰의
# https://estaitt.com/login_id 값으로 User.loginId를 찾는다. 비우면 꺼진다.
AUTH0_DOMAIN="estait.jp.auth0.com"
AUTH0_AUDIENCE="https://api.estaitt.com"
