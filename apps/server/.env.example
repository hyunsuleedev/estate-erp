# Docker development infra lives at /docker-compose.dev.yml.
# Start it with `pnpm infra:up` before running the server.
# If local PostgreSQL or Redis already use 5432/6379, stop them first.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/estate_erp"
JWT_SECRET="your-jwt-secret-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
JWT_REFRESH_EXPIRES_IN="7d"
REDIS_URL="redis://127.0.0.1:6379"
RESEND_API_KEY="re_your_api_key"
PORT=3000

# Rule Engine — AI 직원 규칙 엔진 실행 토글
# true 로 두면 @nestjs/schedule 기반 in-process cron 이 동작한다.
# 다중 인스턴스 배포시 하나의 인스턴스에만 true 를 주거나 BullMQ 로 전환해야 한다.
RULE_ENGINE_ENABLED="true"

# ============================================================
# Supabase Auth (인증만 외주, DB는 자체 RDS/docker postgres)
# ============================================================
# 사장님 발급 모델 (모델 B):
#   - Sign-ups 비활성 (Disable Sign Ups in Supabase Auth Settings)
#   - 사장님이 admin.createUser로 직원 발급
#   - 합성 이메일 패턴: {loginId}@{SUPABASE_SYNTHETIC_DOMAIN}
#   - 비번 재설정도 사장님이 admin.updateUserById (옵션 1)
#
# 비번 복구 옵션 1: 사장님 직접 재설정 (PATCH /users/:id/reset-password)
# 합성 이메일은 실재하지 않으므로 Supabase 기본 reset 메일 흐름은 사용 불가.
#
# JWT 검증: Supabase JWT Signing Keys (비대칭 ES256/RS256) + JWKS endpoint 자동 조회.
#   JWKS URL = ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (코드에서 자동 구성)
#   Legacy JWT Secret(HS256, SUPABASE_JWT_SECRET)은 사용 안 함.

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."          # 또는 legacy eyJ... anon key
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."        # 절대 클라이언트 노출 X (legacy: eyJ...)
SUPABASE_SYNTHETIC_DOMAIN="estate-erp.local"     # 합성 이메일 도메인

# Clerk Auth
# Server-side secret key used to verify Clerk session tokens and fetch user
# emails during first-login auto-linking.
CLERK_SECRET_KEY="sk_test_..."

# MCP audience (RFC 8707 Resource Indicators)
# Phase 1엔 자체 JWT로 MCP 처리 (이미 구현됨), Phase 1.5+에 OAuth 정식
MCP_AUDIENCE="http://localhost:3000/mcp"
