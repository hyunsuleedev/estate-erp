<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>EstateErp.CtiBridge</RootNamespace>
    <AssemblyName>cti-bridge</AssemblyName>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      개발(mock)은 어느 플랫폼에서든 dotnet run 으로 실행 가능 (AnyCPU).
      운영 배포는 KT COM(32비트) 제약 때문에 반드시 win-x86 self-contained로 publish:
        dotnet publish -c Release -r win-x86 - -self-contained -p:PublishSingleFile=true
      (docs/CTI_BRIDGE_PLAN.md §4.1)
    -->
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    KT COM 바인딩 (tlbimp, docs/CTI_BRIDGE_PLAN.md Step 0):
    Windows에서 `tlbimp KTOpenAPI.dll /out:Interop.KTPCBizLib.dll`로 생성한 산출물을
    lib/ 에 커밋하면 KT_INTEROP이 자동 정의되어 TlbImpKtPcBizClient 실제 구현이 활성화된다.
    없으면 placeholder로 컴파일되어 mock 개발 흐름(macOS 포함)이 유지된다.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/lib/Interop.KTPCBizLib.dll')">
    <DefineConstants>$(DefineConstants);KT_INTEROP</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/lib/Interop.KTPCBizLib.dll')">
    <Reference Include="Interop.KTPCBizLib">
      <HintPath>lib/Interop.KTPCBizLib.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
