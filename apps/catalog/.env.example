# Optional: defaults to /api, proxied to localhost:3000 in development.
# Production: use the ERP API origin, or configure a same-origin /api reverse proxy.
# VITE_API_BASE_URL=https://api.example.com

# NAVER Cloud Maps application client ID (public browser key, never a secret key).
# Enable Web Dynamic Map and register the local/production website origin.
VITE_NAVER_MAPS_NCP_KEY_ID=

# Same Clerk instance as the ERP server; consumers do not become ERP employees.
VITE_CLERK_PUBLISHABLE_KEY=
