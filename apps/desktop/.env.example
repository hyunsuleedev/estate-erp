# Estate ERP Desktop — 환경 변수 예시
#
# 사용법: .env.local 파일을 만들고 필요한 값만 덮어쓴다.
# .env.local은 gitignore에 포함되어 커밋되지 않음.
#
# VITE_ 접두사가 붙은 변수만 renderer 코드에서 import.meta.env로 접근 가능.

# 백엔드 API base URL — 상황에 따라 바꿔 쓴다.
#   로컬 NestJS:  http://localhost:3000
#   배포된 AWS:   https://api.estaitt.com
#   staging 등:   https://staging-api.estaitt.com
#
# 비워두면 api.ts의 fallback 로직 사용 (file:// → http://localhost:3000).
VITE_API_BASE_URL="http://localhost:3000"

# 로그인은 main 프로세스가 Auth0로 한다. 어느 테넌트로 로그인할지는 빌드할 때 정해진다
# (VITE_API_BASE_URL과 같은 방식). 비워 두면 시험 테넌트(estait.jp.auth0.com)다.
# 운영 빌드는 네 값을 모두 정한다. 모두 공개 값이다(앱 비밀값 없이 로그인한다).
#   VITE_AUTH0_DOMAIN     테넌트 도메인        예: login.estaitt.com
#   VITE_AUTH0_CLIENT_ID  데스크톱(Native) 앱의 client ID
#   VITE_AUTH0_AUDIENCE   우리 API 식별자      예: https://api.estaitt.com
#   VITE_AUTH0_REALM      아이디·비밀번호 DB 연결 이름
# VITE_AUTH0_DOMAIN=""
# VITE_AUTH0_CLIENT_ID=""
# VITE_AUTH0_AUDIENCE=""
# VITE_AUTH0_REALM=""
#
# 개발 실행(pnpm dev)에서만, 앱을 띄울 때 실행 환경 변수로 빌드 값을 덮어쓸 수 있다:
#   ESTATE_AUTH0_DOMAIN, ESTATE_AUTH0_CLIENT_ID, ESTATE_AUTH0_AUDIENCE, ESTATE_AUTH0_REALM
# 패키지 앱은 이 실행 환경 변수를 무시한다(로그인 정보가 갈 곳을 실행 환경이 바꾸지 못한다).
VITE_NAVER_MAPS_NCP_KEY_ID="your_naver_maps_ncp_key_id"

# Electron auto update base URL.
# Packaged app only. Expected static layout:
#   {ESTATE_ERP_UPDATE_BASE_URL}/win32/x64/RELEASES
#   {ESTATE_ERP_UPDATE_BASE_URL}/darwin/arm64/RELEASES.json
ESTATE_ERP_UPDATE_BASE_URL="https://updates.example.com/estate-erp"
