# scripts/deploy-server.sh가 읽는 내 Mac의 배포 설정 틀. .env.deploy로 복사해 채운다(git에 올라가지 않는다).

AWS_REGION=ap-northeast-2
# 내 Mac의 AWS CLI 프로필 이름. ECR에 올리고, EC2에 Systems Manager 명령을 보내고, Parameter Store에 쓸 권한이 있어야 한다.
AWS_PROFILE=
ECR_REPOSITORY=estaitflow-server

# 운영 서버(EC2)의 인스턴스 ID. SSH가 아니라 Systems Manager로 명령을 보낸다.
EC2_INSTANCE_ID=
# EC2에서 배포 파일을 두는 폴더
REMOTE_DIR=/home/ubuntu/estaitflow
# 서버의 비밀값(.env.prod)을 암호화해 두는 Parameter Store 이름
ENV_PARAMETER=/estaitflow/prod/env

# Caddy가 인증서를 받을 도메인 (시험할 때는 api-dev.estaitt.com)
API_DOMAIN=api.estaitt.com
