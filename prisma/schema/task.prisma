// ============================================================
// 업무/태스크
// ============================================================

model Task {
  id        String    @id @default(uuid()) @db.Uuid
  officeId  String    @map("office_id") @db.Uuid
  title     String
  content   String?
  source    String    @default("manual") // manual, system, ai
  status    String    @default("pending") // pending, in_progress, completed, cancelled
  priority  String    @default("medium") // urgent, high, medium, low
  category  String    @default("other") // property, buyer, match, deal, contract, consultation, viewing, admin, other, advertisement, call, document, verify
  sortOrder Int       @default(0) @map("sort_order")
  dueDate   DateTime? @map("due_date")

  // 담당자
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  createdById  String?   @map("created_by_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime? @map("assigned_at")

  // 관련 컨텍스트 (상담에서 할 일 생성 시 자동 연결)
  contactId       String? @map("contact_id") @db.Uuid
  propertyId      String? @map("property_id") @db.Uuid
  listingIntakeId String? @map("listing_intake_id") @db.Uuid
  listingId       String? @map("listing_id") @db.Uuid
  consultationId  String? @map("consultation_id") @db.Uuid
  buyerReqId      String? @map("buyer_req_id") @db.Uuid
  matchId         String? @map("match_id") @db.Uuid
  dealId          String? @map("deal_id") @db.Uuid
  contractId      String? @map("contract_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office           Office            @relation(fields: [officeId], references: [id])
  assignedTo       User?             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy        User?             @relation("TaskCreator", fields: [createdById], references: [id])
  assignedBy       User?             @relation("TaskAssigner", fields: [assignedById], references: [id])
  contact          Contact?          @relation(fields: [contactId], references: [id])
  property         Property?         @relation(fields: [propertyId], references: [id])
  listingIntake    ListingIntake?    @relation(fields: [listingIntakeId], references: [id])
  listing          Listing?          @relation(fields: [listingId], references: [id])
  consultation     Consultation?     @relation(fields: [consultationId], references: [id])
  buyerRequirement BuyerRequirement? @relation(fields: [buyerReqId], references: [id])
  match            Match?            @relation(fields: [matchId], references: [id])
  deal             Deal?             @relation(fields: [dealId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  agentSessions    AgentSession[]

  @@index([officeId, status, dueDate])
  @@index([officeId, assignedToId])
  @@index([officeId, createdById])
  @@index([officeId, assignedById])
  @@index([contactId])
  @@index([propertyId])
  @@index([listingIntakeId])
  @@index([listingId])
  @@index([consultationId])
  @@index([buyerReqId])
  @@index([matchId])
  @@index([dealId])
  @@index([contractId])
  @@map("tasks")
}

// ============================================================
// 캘린더 이벤트
// ============================================================

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  officeId    String    @map("office_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  type        String    @default("general") // viewing, contract, meeting, task, general
  allDay      Boolean   @default(false) @map("all_day")
  start       DateTime
  end         DateTime?
  color       String? // FullCalendar backgroundColor (hex)

  // 관련 엔티티 연결 (선택)
  propertyId      String? @map("property_id") @db.Uuid
  listingIntakeId String? @map("listing_intake_id") @db.Uuid
  listingId       String? @map("listing_id") @db.Uuid
  contactId       String? @map("contact_id") @db.Uuid
  matchId         String? @map("match_id") @db.Uuid
  dealId          String? @map("deal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office        Office         @relation(fields: [officeId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  property      Property?      @relation(fields: [propertyId], references: [id])
  listingIntake ListingIntake? @relation(fields: [listingIntakeId], references: [id])
  listing       Listing?       @relation(fields: [listingId], references: [id])
  contact       Contact?       @relation(fields: [contactId], references: [id])
  match         Match?         @relation(fields: [matchId], references: [id])
  deal          Deal?          @relation(fields: [dealId], references: [id])

  @@index([officeId, start])
  @@index([officeId, userId])
  @@index([listingIntakeId])
  @@map("calendar_events")
}

// ============================================================
// 활동 로그 (감사 추적)
// ============================================================

/// 데이터 변경 이력. MCP/웹/시스템 모든 소스의 변경을 추적.
model ActivityLog {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  // 누가
  userId String? @map("user_id") @db.Uuid // 직원이 한 작업이면 FK, 시스템/MCP는 null
  actor  String // "user", "mcp:claude", "system"
  source String // "web", "mcp", "system"

  // 뭘 했는지
  action     String // "create", "update", "delete"
  entityType String @map("entity_type") // "property", "listing", "contact", "deal" 등
  entityId   String @map("entity_id") @db.Uuid

  // 변경 내용
  changes Json?   @db.JsonB // { "lastCheckResult": { "before": "no_answer", "after": "alive" } }
  reason  String? // AI가 보내주면 저장, 선택적

  createdAt DateTime @default(now()) @map("created_at")

  office Office @relation(fields: [officeId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([officeId, entityType, entityId])
  @@index([officeId, createdAt])
  @@map("activity_logs")
}
