// ============================================================
// 업무/태스크
// ============================================================

model Task {
  id       String    @id @default(uuid()) @db.Uuid
  officeId String    @map("office_id") @db.Uuid
  title    String
  content  String?
  source   String    @default("manual") // manual, system, ai
  isDone   Boolean   @default(false) @map("is_done")
  dueDate  DateTime? @map("due_date")

  // 관련 컨텍스트 (상담에서 할 일 생성 시 자동 연결)
  contactId      String? @map("contact_id") @db.Uuid
  propertyId     String? @map("property_id") @db.Uuid
  consultationId String? @map("consultation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])

  @@map("tasks")
}

// ============================================================
// 인사이트 / 규칙 엔진
// ============================================================

model Insight {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  type      String // price_change, verification_due, match_found, contract_due, ad_rank_change
  title     String
  content   String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  office Office @relation(fields: [officeId], references: [id])

  @@map("insights")
}

model InsightRule {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  type      String // 규칙 유형
  config    Json // 규칙 설정 JSON
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])

  @@map("insight_rules")
}

// ============================================================
// 캘린더 이벤트
// ============================================================

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  officeId    String    @map("office_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  type        String    @default("general") // viewing, contract, meeting, task, general
  allDay      Boolean   @default(false) @map("all_day")
  start       DateTime
  end         DateTime?
  color       String? // FullCalendar backgroundColor (hex)

  // 관련 엔티티 연결 (선택)
  propertyId String? @map("property_id") @db.Uuid
  contactId  String? @map("contact_id") @db.Uuid
  matchId    String? @map("match_id") @db.Uuid
  dealId     String? @map("deal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office   Office    @relation(fields: [officeId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  contact  Contact?  @relation(fields: [contactId], references: [id])
  match    Match?    @relation(fields: [matchId], references: [id])
  deal     Deal?     @relation(fields: [dealId], references: [id])

  @@index([officeId, start])
  @@index([officeId, userId])
  @@map("calendar_events")
}

// ============================================================
// 활동 로그 (감사 추적)
// ============================================================

/// 데이터 변경 이력. MCP/웹/시스템 모든 소스의 변경을 추적.
model ActivityLog {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  // 누가
  userId String? @map("user_id") @db.Uuid // 직원이 한 작업이면 FK, 시스템/MCP는 null
  actor  String // "user", "mcp:claude", "system:rule_engine"
  source String // "web", "mcp", "system"

  // 뭘 했는지
  action     String // "create", "update", "delete"
  entityType String @map("entity_type") // "property", "contact", "deal" 등
  entityId   String @map("entity_id") @db.Uuid

  // 변경 내용
  changes Json?   @db.JsonB // { "checkStatus": { "before": "unverified", "after": "verified" } }
  reason  String? // AI가 보내주면 저장, 선택적

  createdAt DateTime @default(now()) @map("created_at")

  office Office @relation(fields: [officeId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([officeId, entityType, entityId])
  @@index([officeId, createdAt])
  @@map("activity_logs")
}
