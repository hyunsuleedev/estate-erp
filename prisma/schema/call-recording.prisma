// ============================================================
// 통화 녹음 + STT (발화 메시지 단위 저장)
// ============================================================

model CallRecording {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  /// 통화 상대 연락처 (null = 미등록 번호)
  contactId String? @map("contact_id") @db.Uuid
  /// 통화한 중개사
  userId    String  @map("user_id") @db.Uuid

  /// inbound (수신) / outbound (발신)
  direction   String
  phoneNumber String @map("phone_number")
  durationSec Int    @default(0) @map("duration_sec")

  /// 녹음 파일 정보
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url") // S3 업로드 후
  fileSize Int?    @map("file_size")

  /// STT 상태: none / pending / processing / completed / failed
  sttStatus   String  @default("pending") @map("stt_status")
  /// 받아쓰기 업체: gemini / vito / dummy
  sttProvider String? @map("stt_provider")
  /// 받아쓰기 실패 이유 (화면 표시용)
  sttError    String? @map("stt_error")

  /// LLM 분석 결과 (Gemini)
  /// { summary, keyPoints, callType, sentiment, agentSpeaker, consultationContent, model }
  analysis           Json?     @db.JsonB
  /// 분석 상태: none / processing / completed / failed
  analysisStatus     String    @default("none") @map("analysis_status")
  /// 마지막 분석 요청 id. 분석이 겹치면 가장 나중 요청의 결과만 저장한다.
  analysisRunId      String?   @map("analysis_run_id") @db.Uuid
  analyzedAt         DateTime? @map("analyzed_at")
  /// 분석이 자동으로 만든 상담 기록 (다시 분석할 때 새로 만들지 않고 고친다)
  autoConsultationId String?   @map("auto_consultation_id") @db.Uuid

  /// 통화 시각
  calledAt DateTime @map("called_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office        Office                 @relation(fields: [officeId], references: [id])
  contact       Contact?               @relation(fields: [contactId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])
  messages      CallRecordingMessage[]
  consultations Consultation[]
  callLogs      CallLog[]
  suggestions   CallActionSuggestion[]

  @@index([officeId, calledAt])
  @@index([officeId, phoneNumber])
  @@index([contactId])
  @@map("call_recordings")
}

model CallRecordingMessage {
  id          String @id @default(uuid()) @db.Uuid
  recordingId String @map("recording_id") @db.Uuid

  /// 화자 번호 (VITO: 0, 1, ...)
  speaker      Int
  /// 화자 라벨 (null → 나중에 "나"/"고객" 등으로 업데이트)
  speakerLabel String? @map("speaker_label")

  /// 발화 텍스트
  text String

  /// 음성 구간 (ms) — 구간 재생용
  startMs Int @map("start_ms")
  endMs   Int @map("end_ms")

  /// 순서 (0부터)
  seq Int

  createdAt DateTime @default(now()) @map("created_at")

  recording CallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId, seq])
  @@map("call_recording_messages")
}

// ============================================================
// 통화 분석이 제안한 업무
//
// 통화 내용을 분석해 할 일·일정·고객 요청·매칭·매물 확인을 제안한다.
// 받아쓰기는 숫자·단지명·화자를 틀릴 수 있으므로 바로 반영하지 않고
// 사람이 내용을 확인(필요하면 고쳐서)한 뒤 반영한다.
// ============================================================

model CallActionSuggestion {
  id             String  @id @default(uuid()) @db.Uuid
  officeId       String  @map("office_id") @db.Uuid
  recordingId    String  @map("recording_id") @db.Uuid
  /// 통화로 자동 생성된 상담 기록 (연락처를 모르면 null)
  consultationId String? @map("consultation_id") @db.Uuid
  /// 분석할 때의 통화 상대. 통화 연락처가 바뀌면 이 제안은 반영할 수 없다.
  contactId      String? @map("contact_id") @db.Uuid

  /// task / calendar_event / buyer_requirement_create / buyer_requirement_update
  /// / match_create / match_stage / listing_confirm
  type     String
  /// pending / applying / accepted / dismissed
  status   String  @default("pending")
  /// 한 줄 요약 ("내일 오후 3시 김OO님 임장")
  title    String
  /// 근거가 된 통화 원문
  evidence String?
  /// 제안 내용. 서버가 검증하고 실제 id로 바꾼 값만 저장한다.
  payload  Json    @db.JsonB
  /// 분석 결과 안에서의 순서
  seq      Int     @default(0)

  /// 반영 결과
  appliedEntityType String?   @map("applied_entity_type")
  appliedEntityId   String?   @map("applied_entity_id") @db.Uuid
  /// 실제로 반영한 내용 (도메인에 쓰기 전에 기록해 다시 시도할 때 무엇이 적용됐는지 안다)
  appliedPayload    Json?     @map("applied_payload") @db.JsonB
  resolvedById      String?   @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office       Office        @relation(fields: [officeId], references: [id])
  recording    CallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("CallSuggestionResolver", fields: [resolvedById], references: [id])

  @@index([officeId, status, createdAt])
  @@index([recordingId, seq])
  @@index([consultationId])
  @@map("call_action_suggestions")
}
