// ============================================================
// 연락처 (모든 사람·법인의 기본 정보 — 법적 권리주체)
// kind: 'person' (개인) | 'organization' (법인·단체)
// ============================================================

model Contact {
  id                  String   @id @default(uuid()) @db.Uuid
  officeId            String   @map("office_id") @db.Uuid
  kind                String   @default("person") // person, organization
  name                String
  businessRegNo       String?  @map("business_reg_no")
  email               String?
  memo                String?
  referredByContactId String?  @map("referred_by_contact_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  office                  Office                 @relation(fields: [officeId], references: [id])
  referredBy              Contact?               @relation("ContactReferral", fields: [officeId, referredByContactId], references: [officeId, id], onDelete: Restrict)
  referrals               Contact[]              @relation("ContactReferral")
  phones                  ContactPhone[]
  organizationParty       Party?                 @relation("PartyOrganizationContact")
  partyMemberships        PartyMember[]          @relation("PartyMemberContact")
  propertyContacts        PropertyContact[]
  buyerIntakeContacts     BuyerIntakeContact[]
  consultations           Consultation[]
  leaseTenancies          PropertyLeaseTenant[]
  tasks                   Task[]
  calendarEvents          CalendarEvent[]
  dealsAsBuyer            Deal[]                 @relation("DealBuyer")
  dealsAsSeller           Deal[]                 @relation("DealSeller")
  contractParties         ContractParty[]
  commissionPayments      CommissionPayment[]    @relation("CommissionPayer")
  // 통화 녹음 및 제안
  callRecordings          CallRecording[]
  callActionSuggestions   CallActionSuggestion[]
  // 통화 이벤트 로그 (CTI)
  callLogs                CallLog[]
  groupMemberships        ContactGroupMember[]
  tagAssignments          ContactTagAssignment[]
  /// 이 사람이 대표 고객인 프로젝트
  primaryProjects         Project[]              @relation("ProjectPrimaryContact")

  // office_id를 포함하는 관계 FK가 tenant 경계를 DB에서도 강제할 수 있게 한다.
  @@unique([officeId, id])
  @@unique([officeId, id, kind])
  @@index([officeId, kind])
  @@index([officeId, referredByContactId])
  @@map("contacts")
}

// ============================================================
// 연락처 그룹 (사무소가 직접 만드는 묶음: VIP, 설 선물 등)
// 그룹과 태그는 다른 것이다. 태그(ContactTag)는 그 사람을 설명하는 말이라 표의 칸에
// 꼬리표로 붙고, 그룹은 사람이 골라 넣어 관리하는 명단이라 왼쪽 목록에 나온다.
// 소속은 ContactGroupMember의 한 줄이다.
// ============================================================

model ContactGroup {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office  Office               @relation(fields: [officeId], references: [id])
  members ContactGroupMember[]

  @@unique([officeId, name])
  // 소속 FK가 사무소 경계를 DB에서도 지키게 한다.
  @@unique([officeId, id])
  @@map("contact_groups")
}

// ============================================================
// 그룹 소속 (그룹 ↔ 사람). 한 사람이 여러 그룹에 들어갈 수 있다.
// 그룹별 칸 같은 확장은 두지 않는다. 누가 언제 넣었는지만 남긴다.
// ============================================================

model ContactGroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  /// 넣은 직원. 직원이 지워지면 비운다.
  addedById String?  @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  office  Office       @relation(fields: [officeId], references: [id])
  group   ContactGroup @relation(fields: [officeId, groupId], references: [officeId, id], onDelete: Cascade)
  contact Contact      @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Cascade)
  addedBy User?        @relation("ContactGroupMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([groupId, contactId])
  @@index([officeId, contactId])
  @@map("contact_group_members")
}

// ============================================================
// 연락처 태그 (그 사람을 설명하는 말: 신혼, 학군, VIP)
// 2026-11-18 이전에는 Contact.tags 글자 배열이었다. 공백·대소문자 변형이 쌓이고
// 이름을 바꾸려면 모든 연락처를 다시 써야 해서 표로 옮겼다.
// ============================================================

model ContactTag {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  /// 앞뒤 공백을 떼고 가운데 공백을 하나로 줄인 이름. 사무소 안에서 유일하다.
  name      String
  /// 색 이름 (packages/shared의 CONTACT_TAG_COLORS). 허용값은 DB CHECK로도 막는다.
  color     String   @default("gray")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office      Office                 @relation(fields: [officeId], references: [id])
  assignments ContactTagAssignment[]

  @@unique([officeId, name])
  // 연결 FK가 사무소 경계를 DB에서도 지키게 한다.
  @@unique([officeId, id])
  @@map("contact_tags")
}

// ============================================================
// 태그 연결 (태그 ↔ 사람). 한 사람이 여러 태그를 가진다.
// ============================================================

model ContactTagAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  /// 붙인 직원. 직원이 지워지면 비운다.
  addedById String?  @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  office  Office     @relation(fields: [officeId], references: [id])
  tag     ContactTag @relation(fields: [officeId, tagId], references: [officeId, id], onDelete: Cascade)
  contact Contact    @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Cascade)
  addedBy User?      @relation("ContactTagAssignmentAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([tagId, contactId])
  @@index([officeId, contactId])
  @@map("contact_tag_assignments")
}

// ============================================================
// 연락처 전화번호 (한 사람 ↔ 여러 번호)
// ============================================================

model ContactPhone {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  /// 숫자만 저장하는 canonical 전화번호. 화면 포맷은 클라이언트가 담당한다.
  phone     String
  label     String   @default("mobile") // mobile, home, work, office, fax, other
  isPrimary Boolean  @default(false) @map("is_primary")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office  Office  @relation(fields: [officeId], references: [id])
  contact Contact @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Cascade)

  // 같은 사무소의 mobile 번호만 유일(partial unique index는 migration SQL). 집전화/팩스 등은 공유 허용.
  @@unique([contactId, phone])
  @@index([officeId, phone])
  @@index([contactId])
  // Contact당 대표번호는 최대 한 개. partial unique index는 migration SQL에서 생성한다.
  @@map("contact_phones")
}

// ============================================================
// 집단/소속 (세대 household · 법인 organization)
// 개인(Contact kind=person)을 묶어 세대 단위 상담·자산 조회 및 법인 담당자를 표현한다.
// 법인은 Contact(kind=organization)에 존재하며 Party(kind=organization)가 1:1 연결된다.
// ============================================================

model Party {
  id                      String   @id @default(uuid()) @db.Uuid
  officeId                String   @map("office_id") @db.Uuid
  kind                    String // household | organization
  name                    String?
  organizationContactId   String?  @map("organization_contact_id") @db.Uuid
  organizationContactKind String?  @map("organization_contact_kind")
  homePhone               String?  @map("home_phone")
  memo                    String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  office              Office        @relation(fields: [officeId], references: [id])
  organizationContact Contact?      @relation("PartyOrganizationContact", fields: [officeId, organizationContactId, organizationContactKind], references: [officeId, id, kind], onDelete: Cascade)
  members             PartyMember[]

  @@unique([officeId, id])
  @@unique([officeId, id, kind])
  @@unique([officeId, organizationContactId])
  @@unique([officeId, organizationContactId, organizationContactKind])
  @@index([officeId, kind])
  @@map("parties")
}

model PartyMember {
  id          String   @id @default(uuid()) @db.Uuid
  officeId    String   @map("office_id") @db.Uuid
  partyId     String   @map("party_id") @db.Uuid
  partyKind   String   @map("party_kind") // household | organization
  contactId   String   @map("contact_id") @db.Uuid
  contactKind String   @default("person") @map("contact_kind")
  roleLabel   String?  @map("role_label")
  isPrimary   Boolean  @default(false) @map("is_primary")
  status      String   @default("active") // active | inactive
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  office  Office  @relation(fields: [officeId], references: [id])
  party   Party   @relation(fields: [officeId, partyId, partyKind], references: [officeId, id, kind], onDelete: Cascade)
  contact Contact @relation("PartyMemberContact", fields: [officeId, contactId, contactKind], references: [officeId, id, kind], onDelete: Cascade)

  @@index([officeId, partyId])
  @@index([officeId, contactId])
  @@map("party_members")
}

// ============================================================
// 매물 관련 연락처 (매물 ↔ 사람/법인, 소유·권리 이력)
// ============================================================

model PropertyContact {
  id           String    @id @default(uuid()) @db.Uuid
  officeId     String    @map("office_id") @db.Uuid
  contactId    String    @map("contact_id") @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  role         String // owner, co_owner, representative, lawyer, tax_agent
  shareRatio   Decimal?  @map("share_ratio") @db.Decimal // owner/co_owner 지분비율 (%)
  isResident   Boolean   @default(false) @map("is_resident")
  /// 이 Property에서의 주 연락 창구. Contact 자체의 전역 대표 여부가 아니다.
  isPrimary    Boolean   @default(false) @map("is_primary")
  status       String    @default("active") // active, transferred, archived
  startedAt    DateTime? @map("started_at")
  endedAt      DateTime? @map("ended_at")
  sourceDealId String?   @map("source_deal_id") @db.Uuid
  memo         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  office     Office   @relation(fields: [officeId], references: [id])
  contact    Contact  @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Restrict)
  property   Property @relation(fields: [propertyId], references: [id])
  sourceDeal Deal?    @relation("PropertyContactSourceDeal", fields: [sourceDealId], references: [id], onDelete: SetNull)

  @@index([contactId, propertyId, role])
  @@index([officeId])
  @@index([propertyId])
  @@index([sourceDealId])
  // 활성 중복 역할 방지 & 활성 주 연락처는 Property당 최대 한 명 (partial unique index는 migration SQL).
  @@map("property_contacts")
}

// ============================================================
// 임대차 계약 및 임차인 (매물별 임대차 1건 + N명 임차인/거주자)
// ============================================================

model PropertyLease {
  id               String    @id @default(uuid()) @db.Uuid
  officeId         String    @map("office_id") @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  deposit          Int? // 보증금 (만원)
  monthlyRent      Int?      @map("monthly_rent") // 월세 (만원)
  contractStart    DateTime? @map("contract_start")
  contractEnd      DateTime? @map("contract_end")
  moveOutDate      DateTime? @map("move_out_date")
  status           String    @default("residing") // residing, moving_out, moved
  sourceDealId     String?   @map("source_deal_id") @db.Uuid
  sourceContractId String?   @map("source_contract_id") @db.Uuid
  memo             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  office         Office                @relation(fields: [officeId], references: [id])
  property       Property              @relation(fields: [propertyId], references: [id])
  sourceDeal     Deal?                 @relation("PropertyLeaseSourceDeal", fields: [sourceDealId], references: [id], onDelete: SetNull)
  sourceContract Contract?             @relation("PropertyLeaseSourceContract", fields: [sourceContractId], references: [id], onDelete: SetNull)
  tenants        PropertyLeaseTenant[]

  @@unique([officeId, id])
  @@index([officeId])
  @@index([officeId, status, contractEnd])
  @@index([propertyId])
  @@map("property_leases")
}

model PropertyLeaseTenant {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  leaseId   String   @map("lease_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  role      String   @default("tenant") // tenant, co_tenant, resident
  isPrimary Boolean  @default(false) @map("is_primary")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office  Office        @relation(fields: [officeId], references: [id])
  lease   PropertyLease @relation(fields: [officeId, leaseId], references: [officeId, id], onDelete: Cascade)
  contact Contact       @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Restrict)

  @@unique([leaseId, contactId])
  @@index([officeId, contactId])
  // 임대차당 주 연락 임차인은 최대 한 명 (partial unique index는 migration SQL).
  @@map("property_lease_tenants")
}
