// ============================================================
// 연락처 (모든 사람의 기본 정보)
// ============================================================

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String
  email     String?
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office              Office                 @relation(fields: [officeId], references: [id])
  phones              ContactPhone[]
  propertyContacts    PropertyContact[]
  buyerIntakeContacts BuyerIntakeContact[]
  consultations       Consultation[]
  tenants             Tenant[]
  tasks               Task[]
  calendarEvents      CalendarEvent[]
  dealsAsBuyer        Deal[]                 @relation("DealBuyer")
  dealsAsSeller       Deal[]                 @relation("DealSeller")
  contractsAsBuyer    Contract[]             @relation("ContractBuyer")
  contractsAsSeller   Contract[]             @relation("ContractSeller")
  contractParties     ContractParty[]
  commissionPayments  CommissionPayment[]    @relation("CommissionPayer")
  // 통화 녹음
  callRecordings      CallRecording[]
  // 통화 이벤트 로그 (CTI)
  callLogs            CallLog[]
  // ContactRelation 양방향
  relationsAsMain     ContactRelation[]      @relation("MainContact")
  relationsAsRelated  ContactRelation[]      @relation("RelatedContact")
  groupMemberships    ContactGroupMember[]
  tagAssignments      ContactTagAssignment[]
  /// 이 사람이 대표 고객인 프로젝트
  primaryProjects     Project[]              @relation("ProjectPrimaryContact")

  // office_id를 포함하는 관계 FK가 tenant 경계를 DB에서도 강제할 수 있게 한다.
  @@unique([officeId, id])
  @@map("contacts")
}

// ============================================================
// 연락처 그룹 (사무소가 직접 만드는 묶음: VIP, 설 선물 등)
// 그룹과 태그는 다른 것이다. 태그(ContactTag)는 그 사람을 설명하는 말이라 표의 칸에
// 꼬리표로 붙고, 그룹은 사람이 골라 넣어 관리하는 명단이라 왼쪽 목록에 나온다.
// 소속은 ContactGroupMember의 한 줄이다.
// ============================================================

model ContactGroup {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office  Office               @relation(fields: [officeId], references: [id])
  members ContactGroupMember[]

  @@unique([officeId, name])
  // 소속 FK가 사무소 경계를 DB에서도 지키게 한다.
  @@unique([officeId, id])
  @@map("contact_groups")
}

// ============================================================
// 그룹 소속 (그룹 ↔ 사람). 한 사람이 여러 그룹에 들어갈 수 있다.
// 그룹별 칸 같은 확장은 두지 않는다. 누가 언제 넣었는지만 남긴다.
// ============================================================

model ContactGroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  /// 넣은 직원. 직원이 지워지면 비운다.
  addedById String?  @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  office  Office       @relation(fields: [officeId], references: [id])
  group   ContactGroup @relation(fields: [officeId, groupId], references: [officeId, id], onDelete: Cascade)
  contact Contact      @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Cascade)
  addedBy User?        @relation("ContactGroupMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([groupId, contactId])
  @@index([officeId, contactId])
  @@map("contact_group_members")
}

// ============================================================
// 연락처 태그 (그 사람을 설명하는 말: 신혼, 학군, VIP)
// 2026-11-18 이전에는 Contact.tags 글자 배열이었다. 공백·대소문자 변형이 쌓이고
// 이름을 바꾸려면 모든 연락처를 다시 써야 해서 표로 옮겼다.
// ============================================================

model ContactTag {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  /// 앞뒤 공백을 떼고 가운데 공백을 하나로 줄인 이름. 사무소 안에서 유일하다.
  name      String
  /// 색 이름 (packages/shared의 CONTACT_TAG_COLORS). 허용값은 DB CHECK로도 막는다.
  color     String   @default("gray")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office      Office                 @relation(fields: [officeId], references: [id])
  assignments ContactTagAssignment[]

  @@unique([officeId, name])
  // 연결 FK가 사무소 경계를 DB에서도 지키게 한다.
  @@unique([officeId, id])
  @@map("contact_tags")
}

// ============================================================
// 태그 연결 (태그 ↔ 사람). 한 사람이 여러 태그를 가진다.
// ============================================================

model ContactTagAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  /// 붙인 직원. 직원이 지워지면 비운다.
  addedById String?  @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  office  Office     @relation(fields: [officeId], references: [id])
  tag     ContactTag @relation(fields: [officeId, tagId], references: [officeId, id], onDelete: Cascade)
  contact Contact    @relation(fields: [officeId, contactId], references: [officeId, id], onDelete: Cascade)
  addedBy User?      @relation("ContactTagAssignmentAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([tagId, contactId])
  @@index([officeId, contactId])
  @@map("contact_tag_assignments")
}

// ============================================================
// 연락처 전화번호 (한 사람 ↔ 여러 번호)
// ============================================================

model ContactPhone {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  /// 숫자만 저장하는 canonical 전화번호. 화면 포맷은 클라이언트가 담당한다.
  phone     String
  label     String   @default("mobile") // mobile, home, work, office, fax, other
  isPrimary Boolean  @default(false) @map("is_primary")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office  Office  @relation(fields: [officeId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // 같은 사무소의 canonical 번호는 정확히 한 ContactPhone만 소유할 수 있다.
  @@unique([officeId, phone])
  @@index([contactId])
  // Contact당 대표번호는 최대 한 개. partial unique index는 migration SQL에서 생성한다.
  @@map("contact_phones")
}

// ============================================================
// 연락처 관계 (사람 ↔ 사람, 영구)
// 의뢰가 끝나도 변하지 않는 관계(가족)만 둔다. 법무사·세무사·대리인은 의뢰마다
// 달라지므로 PropertyContact.role에 적는다.
// ============================================================

model ContactRelation {
  id               String   @id @default(uuid()) @db.Uuid
  officeId         String   @map("office_id") @db.Uuid
  /// 기준 인물.
  contactId        String   @map("contact_id") @db.Uuid
  /// 상대 인물. relationType은 이 인물이 기준 인물에게 어떤 관계인지 뜻한다.
  relatedContactId String   @map("related_contact_id") @db.Uuid
  relationType     String   @map("relation_type") // parent, spouse, child, sibling, grandparent, grandchild, other
  /// 기준 인물 화면에서 보여줄 보충 라벨 ("큰어머니", "외할머니")
  label            String?
  /// 상대 인물 화면에서 보여줄 역방향 보충 라벨 ("조카", "외손녀")
  inverseLabel     String?  @map("inverse_label")
  memo             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  office         Office  @relation(fields: [officeId], references: [id])
  contact        Contact @relation("MainContact", fields: [contactId], references: [id])
  relatedContact Contact @relation("RelatedContact", fields: [relatedContactId], references: [id])

  // 자기 연결 금지, relationType 허용값, 방향을 무시한 Contact 쌍 고유성은
  // PostgreSQL CHECK / expression unique index로 강제한다 (migration SQL 참조).
  @@index([contactId, officeId])
  @@index([relatedContactId, officeId])
  @@map("contact_relations")
}

// ============================================================
// 매물 관련 연락처 (매물 ↔ 사람, 역할별)
// ============================================================

model PropertyContact {
  id         String   @id @default(uuid()) @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  role       String // owner, co_owner, representative, lawyer, tax_agent
  shareRatio Decimal? @map("share_ratio") @db.Decimal // owner/co_owner 지분비율 (%)
  isResident Boolean  @default(false) @map("is_resident")
  /// 이 Property에서의 주 연락 창구. Contact 자체의 전역 대표 여부가 아니다.
  isPrimary  Boolean  @default(false) @map("is_primary")
  status     String   @default("active") // active, transferred, archived
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  office   Office   @relation(fields: [officeId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([contactId, propertyId, role])
  @@index([officeId])
  @@index([propertyId])
  // 활성 주 연락처는 Property당 최대 한 명. Prisma가 partial unique index를
  // 표현하지 못하므로 migration SQL에서 DB 제약을 생성한다.
  @@map("property_contacts")
}

// ============================================================
// 세입자 (매물별 현 거주자 + 계약정보)
// ============================================================

model Tenant {
  id            String    @id @default(uuid()) @db.Uuid
  officeId      String    @map("office_id") @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  contactId     String    @map("contact_id") @db.Uuid
  deposit       Int? // 보증금 (만원)
  monthlyRent   Int?      @map("monthly_rent") // 월세 (만원)
  contractStart DateTime? @map("contract_start")
  contractEnd   DateTime? @map("contract_end")
  moveOutDate   DateTime? @map("move_out_date")
  status        String    @default("residing") // residing, moving_out, moved
  memo          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  office   Office   @relation(fields: [officeId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@index([officeId])
  @@index([officeId, status, contractEnd])
  @@index([propertyId])
  @@map("tenants")
}
