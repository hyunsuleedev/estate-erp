// ============================================================
// 연락처 (모든 사람의 기본 정보)
// ============================================================

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String
  // 대표 전화번호 캐시. 실제 여러 전화번호 원본은 ContactPhone에 저장한다.
  phone     String?
  email     String?
  tags      String[]
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office             Office             @relation(fields: [officeId], references: [id])
  phones             ContactPhone[]
  propertyContacts   PropertyContact[]
  listingIntakesRequested ListingIntake[]
  buyerRequirements  BuyerRequirement[]
  consultations      Consultation[]
  tenants            Tenant[]
  tasks              Task[]
  calendarEvents     CalendarEvent[]
  dealsAsBuyer       Deal[]             @relation("DealBuyer")
  dealsAsSeller      Deal[]             @relation("DealSeller")
  contractsAsBuyer   Contract[]         @relation("ContractBuyer")
  contractsAsSeller  Contract[]         @relation("ContractSeller")
  proposals            Proposal[]
  commissionPayments   CommissionPayment[] @relation("CommissionPayer")
  // 통화 녹음
  callRecordings     CallRecording[]
  // ContactRelation 양방향
  relationsAsMain    ContactRelation[]  @relation("MainContact")
  relationsAsRelated ContactRelation[]  @relation("RelatedContact")

  @@unique([officeId, phone])
  @@map("contacts")
}

// ============================================================
// 연락처 전화번호 (한 사람 ↔ 여러 번호)
// ============================================================

model ContactPhone {
  id              String   @id @default(uuid()) @db.Uuid
  officeId        String   @map("office_id") @db.Uuid
  contactId       String   @map("contact_id") @db.Uuid
  phone           String
  normalizedPhone String   @map("normalized_phone")
  label           String   @default("mobile") // mobile, home, work, office, fax, old, other
  isPrimary       Boolean  @default(false) @map("is_primary")
  isActive        Boolean  @default(true) @map("is_active")
  memo            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  office  Office  @relation(fields: [officeId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([officeId, contactId, normalizedPhone])
  @@index([officeId, normalizedPhone])
  @@index([contactId])
  @@map("contact_phones")
}

// ============================================================
// 연락처 관계 (사람 ↔ 사람, 영구)
// ============================================================

model ContactRelation {
  id               String   @id @default(uuid()) @db.Uuid
  officeId         String   @map("office_id") @db.Uuid
  contactId        String   @map("contact_id") @db.Uuid
  relatedContactId String   @map("related_contact_id") @db.Uuid
  relationType     String   @map("relation_type") // parent, spouse, child, sibling, lawyer, tax_agent, other
  label            String? // 기타일 때 또는 보충 ("큰어머니", "담당 법무사")
  memo             String?
  createdAt        DateTime @default(now()) @map("created_at")

  office         Office  @relation(fields: [officeId], references: [id])
  contact        Contact @relation("MainContact", fields: [contactId], references: [id])
  relatedContact Contact @relation("RelatedContact", fields: [relatedContactId], references: [id])

  @@unique([contactId, relatedContactId])
  @@index([officeId])
  @@map("contact_relations")
}

// ============================================================
// 매물 관련 연락처 (매물 ↔ 사람, 역할별)
// ============================================================

model PropertyContact {
  id         String   @id @default(uuid()) @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  role       String // owner, co_owner, representative, lawyer, tax_agent
  shareRatio Decimal? @map("share_ratio") @db.Decimal // owner/co_owner 지분비율 (%)
  isResident Boolean  @default(false) @map("is_resident")
  isPrimary  Boolean  @default(false) @map("is_primary") // 주 연락처
  status     String   @default("active") // active, transferred, archived
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  office   Office   @relation(fields: [officeId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([contactId, propertyId, role])
  @@index([officeId])
  @@index([propertyId])
  @@map("property_contacts")
}

// ============================================================
// 세입자 (매물별 현 거주자 + 계약정보)
// ============================================================

model Tenant {
  id            String    @id @default(uuid()) @db.Uuid
  officeId      String    @map("office_id") @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  contactId     String    @map("contact_id") @db.Uuid
  deposit       Int? // 보증금 (만원)
  monthlyRent   Int?      @map("monthly_rent") // 월세 (만원)
  contractStart DateTime? @map("contract_start")
  contractEnd   DateTime? @map("contract_end")
  moveOutDate   DateTime? @map("move_out_date")
  status        String    @default("residing") // residing, moving_out, moved
  memo          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  office   Office   @relation(fields: [officeId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])
  proposals Proposal[]

  @@index([officeId])
  @@index([officeId, status, contractEnd])
  @@index([propertyId])
  @@map("tenants")
}
