// ============================================================
// 상담 (순수 메모, context FK로 맥락 구분)
// ============================================================

model Consultation {
  id          String @id @default(uuid()) @db.Uuid
  officeId    String @map("office_id") @db.Uuid
  contactId   String @map("contact_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  type        String // phone, visit, online
  purpose     String @default("general") // general, listing_confirm, buyer_consult, deal_followup
  content     String

  // 통화 녹음 연결 (nullable — 녹음 없는 상담도 있음)
  callRecordingId String? @map("call_recording_id") @db.Uuid

  // 컨텍스트 (어떤 맥락의 상담인지, 자동 연결)
  propertyId      String? @map("property_id") @db.Uuid // 호실 맥락 (소유자/세입자 상담)
  listingIntakeId String? @map("listing_intake_id") @db.Uuid // 의뢰 맥락 (방문/권리/현장 메모 등)
  listingId       String? @map("listing_id") @db.Uuid // 매물 맥락 (거래 상담)
  matchId         String? @map("match_id") @db.Uuid
  buyerReqId      String? @map("buyer_req_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office           Office            @relation(fields: [officeId], references: [id])
  contact          Contact           @relation(fields: [contactId], references: [id])
  createdBy        User              @relation("ConsultationCreator", fields: [createdById], references: [id])
  callRecording    CallRecording?    @relation(fields: [callRecordingId], references: [id])
  property         Property?         @relation(fields: [propertyId], references: [id])
  listingIntake    ListingIntake?    @relation(fields: [listingIntakeId], references: [id])
  listing          Listing?          @relation(fields: [listingId], references: [id])
  match            Match?            @relation(fields: [matchId], references: [id])
  buyerRequirement BuyerRequirement? @relation(fields: [buyerReqId], references: [id])
  tasks            Task[]
  callLogs         CallLog[]

  @@index([officeId, contactId])
  @@index([officeId, purpose])
  @@index([officeId, propertyId])
  @@index([officeId, listingIntakeId])
  @@index([officeId, listingId])
  @@map("consultations")
}

// ============================================================
// 구매고객 희망조건
// ============================================================

model BuyerRequirement {
  id               String    @id @default(uuid()) @db.Uuid
  officeId         String    @map("office_id") @db.Uuid
  contactId        String    @map("contact_id") @db.Uuid
  status           String    @default("active") // active, matched, completed, inactive
  urgency          String    @default("normal") // urgent, normal, flexible
  transactionType  String?   @map("transaction_type")
  siteTypes        String[]  @map("site_types")
  priceMin         Int?      @map("price_min")
  priceMax         Int?      @map("price_max")
  depositMin       Int?      @map("deposit_min")
  depositMax       Int?      @map("deposit_max")
  monthlyRentMax   Int?      @map("monthly_rent_max")
  areaMin          Decimal?  @map("area_min") @db.Decimal
  areaMax          Decimal?  @map("area_max") @db.Decimal
  mustConditions   String[]  @map("must_conditions")
  preferConditions String[]  @map("prefer_conditions")
  moveInDate       DateTime? @map("move_in_date")
  assignedToId     String?   @map("assigned_to_id") @db.Uuid
  lastContactDate  DateTime? @map("last_contact_date")
  nextContactDate  DateTime? @map("next_contact_date")
  memo             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  office           Office                   @relation(fields: [officeId], references: [id])
  contact          Contact                  @relation(fields: [contactId], references: [id])
  assignedTo       User?                    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  matches          Match[]
  consultations    Consultation[]
  tasks            Task[]
  preferredSites   BuyerRequirementSite[]
  preferredRegions BuyerRequirementRegion[]

  @@index([officeId, status])
  @@map("buyer_requirements")
}

/// 구매고객이 원하는 구체적 단지 (Site 참조)
model BuyerRequirementSite {
  id         String   @id @default(uuid()) @db.Uuid
  buyerReqId String   @map("buyer_req_id") @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  priority   Int?
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")

  buyerRequirement BuyerRequirement @relation(fields: [buyerReqId], references: [id], onDelete: Cascade)
  site             Site             @relation(fields: [siteId], references: [id])

  @@unique([buyerReqId, siteId])
  @@index([siteId])
  @@map("buyer_requirement_sites")
}

/// 구매고객이 원하는 지역 — 법정동 코드 기반.
/// province/district/ward 중 가장 구체적인 레벨을 원하는 만큼만 채운다.
/// 예: 강동구 전체 → districtCode="11740", wardCode=null
///     고덕동     → districtCode="11740", wardCode="1174010100"
model BuyerRequirementRegion {
  id           String   @id @default(uuid()) @db.Uuid
  buyerReqId   String   @map("buyer_req_id") @db.Uuid
  provinceCode String?  @map("province_code") @db.VarChar(2)
  districtCode String?  @map("district_code") @db.VarChar(5)
  wardCode     String?  @map("ward_code") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  buyerRequirement BuyerRequirement @relation(fields: [buyerReqId], references: [id], onDelete: Cascade)
  province         Province?        @relation(fields: [provinceCode], references: [code])
  district         District?        @relation(fields: [districtCode], references: [code])
  ward             Ward?            @relation(fields: [wardCode], references: [code])

  @@index([buyerReqId])
  @@index([wardCode])
  @@index([districtCode])
  @@map("buyer_requirement_regions")
}

// ============================================================
// 매칭 파이프라인
// ============================================================

model Match {
  id         String   @id @default(uuid()) @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  buyerReqId String   @map("buyer_req_id") @db.Uuid
  stage      String   @default("suggested") // MatchStage enum
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  office           Office           @relation(fields: [officeId], references: [id])
  listing          Listing          @relation(fields: [listingId], references: [id])
  buyerRequirement BuyerRequirement @relation(fields: [buyerReqId], references: [id])
  consultations    Consultation[]
  calendarEvents   CalendarEvent[]
  tasks            Task[]
  deals            Deal[]

  @@map("matches")
}

// ============================================================
// 거래 (Deal)
// 매물 × 고객 조합의 실제 거래 추적. Contract 없이도 자기완결적.
// 조건(가격/특약)은 협상 중 변동 가능하며 ActivityLog 로 이력이 남는다.
// ============================================================

model Deal {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  // ─── 매물/매칭 연결 ────────────────────────────────────────
  /// 우리 DB 의 매물. 공동중개 매수측(외부 매물)은 null 허용.
  listingId         String? @map("listing_id") @db.Uuid
  /// 공동중개로 외부 매물에 매수측으로 붙었을 때 참조 (listingId 와 상호보완)
  externalListingId String? @map("external_listing_id") @db.Uuid
  /// 어느 매칭에서 전환됐는지 (실적/직원 분석용)
  matchId           String? @map("match_id") @db.Uuid

  // ─── 파이프라인 ────────────────────────────────────────────
  /// selection → negotiating → preContract → contracted → settling → completed → closed
  /// `contracted` 이상 단계로 가려면 Contract 레코드가 반드시 존재해야 함
  /// (service layer 에서 강제).
  stage          String   @default("selection")
  stageChangedAt DateTime @default(now()) @map("stage_changed_at")

  /// 취소 여부 (stage 와 직교. 취소되면 stage 는 취소 시점 값으로 동결)
  isCancelled  Boolean   @default(false) @map("is_cancelled")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")
  /// buyer / seller / mutual / external
  cancelledBy  String?   @map("cancelled_by")

  // ─── 거래 당사자 (주 연락처, 공동명의는 Contract 단계에서) ───
  buyerContactId  String? @map("buyer_contact_id") @db.Uuid
  sellerContactId String? @map("seller_contact_id") @db.Uuid

  // ─── 현재 합의 조건 (변동 가능, ActivityLog 로 이력 추적) ───
  transactionType   String    @map("transaction_type") // sale / jeonse / monthly
  /// 합의된 거래가 — "이 거래의 총액" 단일 진실 (매매가 또는 전세금)
  agreedPrice       Int?      @map("agreed_price")
  /// 월세 보증금 (만원)
  agreedDeposit     Int?      @map("agreed_deposit")
  /// 월세 (만원)
  agreedMonthlyRent Int?      @map("agreed_monthly_rent")
  /// 합의된 입주/이전 희망일
  agreedMoveInDate  DateTime? @map("agreed_move_in_date")
  /// 계약서 전 구두 합의 특약 (Contract 생성 시 Contract.specialTerms 로 승격)
  specialTerms      String?   @map("special_terms")

  /// 가계약금이 계약금으로 승계됐는지. true 면 Contract.statedDeposit 에
  /// 금액은 기재되지만 DealPayment(kind='contract') 는 생성되지 않음.
  preContractCarriedOver Boolean @default(false) @map("pre_contract_carried_over")

  // ─── 수수료 요약 ──────────────────────────────────────────
  // 의도적으로 캐시 필드를 두지 않는다.
  // 원천: CommissionPayment + CommissionDistribution. Deal 1건당 payment 2~5행
  // 수준이라 include + 서버 유틸(computeDealCommissionSummary) 로 매 조회 시
  // 계산하는 것이 동기화 복잡도보다 싸다.

  // ─── 공동중개 ──────────────────────────────────────────────
  isJointBrokerage Boolean @default(false) @map("is_joint_brokerage")
  /// 주 파트너 사무소 (FK). 여러 파트너가 있을 수 있지만 대표 하나만 링크.
  /// 상세 분배는 CommissionDistribution 으로 표현.
  partnerBrokerId  String? @map("partner_broker_id") @db.Uuid
  /// 공동중개 시 우리 측이 seller 인지 buyer 인지 both 인지
  ourSide          String? @map("our_side")

  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office          Office           @relation(fields: [officeId], references: [id])
  listing         Listing?         @relation(fields: [listingId], references: [id])
  externalListing ExternalListing? @relation(fields: [externalListingId], references: [id])
  match           Match?           @relation(fields: [matchId], references: [id])
  buyerContact    Contact?         @relation("DealBuyer", fields: [buyerContactId], references: [id])
  sellerContact   Contact?         @relation("DealSeller", fields: [sellerContactId], references: [id])
  partnerBroker   PartnerBroker?   @relation(fields: [partnerBrokerId], references: [id])

  contract           Contract?
  payments           DealPayment[]
  participants       DealParticipant[]
  commissionPayments CommissionPayment[]
  calendarEvents     CalendarEvent[]
  tasks              Task[]
  proposals          Proposal[]

  @@index([officeId, stage])
  @@index([officeId, isCancelled, stage])
  @@index([listingId])
  @@index([matchId])
  @@index([partnerBrokerId])
  @@map("deals")
}

// ============================================================
// 거래 대금 스케줄 (DealPayment)
// 가계약금 / 계약금 / 중도금(여러 차수) / 잔금 / 환불을 row 단위로 추적.
// 실제 돈이 움직이는 이벤트만 생성. 계약서 상 명목 금액은 Contract.stated* 필드.
// ============================================================

model DealPayment {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid

  /// pre_contract / contract / interim / balance / refund
  kind String

  /// 중도금 1차/2차 구분용 (kind='interim'). 나머지 kind 는 1.
  sequence Int @default(1)

  /// 예정 금액 (만원)
  scheduledAmount Int       @map("scheduled_amount")
  /// 예정일
  scheduledDate   DateTime? @map("scheduled_date")

  /// 실제 입금 금액 (만원, 부분입금 시 scheduledAmount 보다 작음)
  paidAmount Int?      @map("paid_amount")
  /// 실제 입금일
  paidAt     DateTime? @map("paid_at")

  /// pending / partial / paid / overdue / cancelled
  status String @default("pending")

  /// 지급 방식: transfer / cash / check / other
  method      String?
  /// 입금 계좌 정보
  accountInfo String? @map("account_info")
  /// 입금자명 (본인 아닌 경우 확인용)
  payerName   String? @map("payer_name")

  /// 영수증/증빙 파일 URL (S3/R2)
  receiptUrl String? @map("receipt_url")

  memo String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, kind, sequence])
  @@index([officeId, status, scheduledDate]) // 캐시플로우 대시보드
  @@index([dealId, kind])
  @@map("deal_payments")
}

// ============================================================
// 계약서 (Contract, Deal 1:1)
// 본계약이 체결되면 생성. 계약서 작성 자체가 트리거이며, 계약금 입금과는
// 별개 이벤트다 (소액 월세·가계약금 승계·법인 거래 등 계약금 없는 케이스 존재).
// 실제 돈 흐름은 DealPayment, 계약서 문서의 명목 금액은 Contract.stated*.
// ============================================================

model Contract {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @unique @map("deal_id") @db.Uuid

  // 거래 유형 (계약서 기준)
  transactionType String @map("transaction_type") // sale / jeonse / monthly

  // 당사자 (계약서 기재자. Deal 의 당사자와 다를 수 있음 - 대리인 등)
  buyerContactId  String @map("buyer_contact_id") @db.Uuid
  sellerContactId String @map("seller_contact_id") @db.Uuid

  // ─── 계약서 상 총액 (Deal.agreedPrice 의 시점 스냅샷) ────────
  /// 계약서 맨 위에 찍히는 총 거래금액 (매매가/전세금, 만원)
  totalPrice Int @map("total_price")

  // ─── 계약서 상 명목 금액 (계약서 문구, 실제 입금은 DealPayment) ─
  /// 계약서상 계약금 (만원). "계약금 X원 계약과 동시 지급" 문구.
  statedDeposit        Int?      @map("stated_deposit")
  /// 계약서상 중도금 (만원)
  statedInterimPayment Int?      @map("stated_interim_payment")
  statedInterimDate    DateTime? @map("stated_interim_date")
  /// 계약서상 잔금 (만원)
  statedBalance        Int?      @map("stated_balance")
  statedBalanceDate    DateTime? @map("stated_balance_date")

  // 월세인 경우
  monthlyRent Int? @map("monthly_rent") // 계약서상 월세 (만원)

  // ─── 상태 ────────────────────────────────────────────────
  /// draft / signed / depositPaid / balancePaid / registered / cancelled
  status String @default("draft")

  // ─── 일정 ────────────────────────────────────────────────
  /// 계약일 (계약서 작성일)
  contractDate DateTime? @map("contract_date")
  /// 입주/이전일
  moveInDate   DateTime? @map("move_in_date")

  // 임대 기간 (전세/월세)
  leaseStartDate DateTime? @map("lease_start_date")
  leaseEndDate   DateTime? @map("lease_end_date")

  // ─── 계약서 내용 ──────────────────────────────────────────
  /// 특약사항 (Deal.specialTerms 에서 승격되거나 계약서 단계에서 추가)
  specialTerms String? @map("special_terms")

  /// 첨부파일 (계약서 PDF, 신분증 스캔 등) — S3/R2 URL
  attachments String[]

  memo String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office        Office             @relation(fields: [officeId], references: [id])
  deal          Deal               @relation(fields: [dealId], references: [id])
  buyerContact  Contact            @relation("ContractBuyer", fields: [buyerContactId], references: [id])
  sellerContact Contact            @relation("ContractSeller", fields: [sellerContactId], references: [id])
  tasks         Task[]
  proposals     Proposal[]
  documents     ContractDocument[]
  parties       ContractParty[]

  @@index([officeId])
  @@index([officeId, status])
  @@map("contracts")
}

// ============================================================
// 계약서 당사자 (레거시 TPCT02S 당사자 + TPCT28S 대리인 대응)
// 공동 매도/매수인 N명, 당사자별 대리인(자기참조), 중개사무소 행을
// 하나의 테이블로 표현. buyer/seller 대표 Contact 2명(Contract.*ContactId)과
// 별개로, 계약서에 인쇄되는 전체 당사자 명부를 담당한다.
// ============================================================

model ContractParty {
  id         String @id @default(uuid()) @db.Uuid
  officeId   String @map("office_id") @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  /// 행 역할 — "one"(레거시 01: 매도/임대/양도측) | "two"(02: 매수/임차/양수측) | "office"(99: 중개사무소)
  side  String
  /// 같은 side 내 순번 (1=대표, 2+=공동 당사자) — 레거시 Sub_Id
  subId Int     @default(1) @map("sub_id")
  /// 표기 라벨 override ("갑", "전대인" 등). null이면 transactionType에서 유도
  role  String?

  name        String
  /// 식별번호 유형 — 레거시 Ownr_Clsf: resident / corporate / foreign / birth
  idType      String? @map("id_type")
  /// 주민/법인/등록번호.
  /// 암호화 저장 필수 — 서버 write-path에서 암호화, 잔금일+15일 후 read 시
  /// 뒷자리 마스킹(레거시 changeRegNumber 정책).
  idNumber    String? @map("id_number")
  address     String?
  phone       String?
  mobilePhone String? @map("mobile_phone")
  /// 거래지분 "N분의 M" — 레거시 Tran_Stak_Silt/Per
  sharePercent String? @map("share_percent")
  country     String?

  /// 고객 마스터 연동 (레거시 Cust_Id)
  contactId String? @map("contact_id") @db.Uuid

  // ─── 대리인 (자기참조, 레거시 TPCT28S) ─────────────────────
  /// null = 본인 행, 값 = 이 당사자(parent)의 대리인 행
  parentId   String? @map("parent_id") @db.Uuid
  /// 대리인 라벨: "대리인" / "공동대리인" / 커스텀
  agentLabel String? @map("agent_label")

  // ─── 사무소 행(side="office") 전용 ─────────────────────────
  officeName      String? @map("office_name")
  officeRegNo     String? @map("office_reg_no")
  /// 공동중개 상대 사무소 참조 (레거시 Comm_Ofcr_Id). FK 없이 UUID만 보관
  partnerOfficeId String? @map("partner_office_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office   Office          @relation(fields: [officeId], references: [id])
  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contact  Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  parent   ContractParty?  @relation("ContractPartyAgent", fields: [parentId], references: [id], onDelete: Cascade)
  agents   ContractParty[] @relation("ContractPartyAgent")

  @@index([officeId, contractId])
  @@index([contactId])
  @@index([parentId])
  @@map("contract_parties")
}

// ============================================================
// 계약 문서 자동화
// ContractDocumentTemplate: 계약 유형별 필수/선택 문서 템플릿
// ContractDocument: 실제 생성·업로드·서명·신고된 문서 파일 추적
// ============================================================

model ContractDocumentTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  /// null 이면 시스템 기본 템플릿, 값이 있으면 사무소 커스텀 템플릿
  officeId String? @map("office_id") @db.Uuid

  /// lease_contract / sale_contract / identity / broker_explanation / transaction_report 등
  code  String
  title String

  /// contract / identity / explanation / report / receipt / attachment
  category String

  /// 적용 거래 유형. 비어 있으면 전체 적용.
  transactionTypes String[] @default([]) @map("transaction_types")

  isRequired Boolean @default(false) @map("is_required")
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")

  metadata Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office    Office?            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  documents ContractDocument[]

  @@unique([officeId, code])
  @@index([officeId, isActive, sortOrder])
  @@map("contract_document_templates")
}

model ContractDocument {
  id         String  @id @default(uuid()) @db.Uuid
  officeId   String  @map("office_id") @db.Uuid
  contractId String  @map("contract_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid

  /// generated / uploaded / external
  type     String
  /// contract / identity / explanation / report / receipt / attachment
  category String
  title    String

  /// 서식 템플릿 코드 — 레거시 Cntr_Clsf 대응 (base_contract / standard_lease_contract / proxy ...)
  kind      String?
  /// 묶음 내 탭 순서 — 레거시 Orde
  sortOrder Int     @default(0) @map("sort_order")
  /// 동일 서식 반복 순번 (위임장 2장 등) — 레거시 Cntr_Clsf_Orde
  kindOrder Int     @default(1) @map("kind_order")

  /// draft / generated / signed / submitted / archived / cancelled
  status String @default("draft")

  fileUrl  String? @map("file_url")
  fileSize Int?    @map("file_size")
  mimeType String? @map("mime_type")

  generatedAt DateTime? @map("generated_at")
  signedAt    DateTime? @map("signed_at")
  submittedAt DateTime? @map("submitted_at")

  generatedById String? @map("generated_by_id") @db.Uuid
  externalRefId String? @map("external_ref_id")

  metadata Json    @default("{}") @db.JsonB
  memo     String?

  /// 마지막으로 사람의 승인을 거쳐 metadata 에 적용된 정확한 revision.
  /// AI가 새 초안을 준비하는 것만으로는 이 포인터와 metadata 가 바뀌지 않는다.
  currentRevisionId String? @unique @map("current_revision_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office          Office                     @relation(fields: [officeId], references: [id])
  contract        Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  template        ContractDocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  generatedBy     User?                      @relation("ContractDocumentGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  currentRevision ContractDocumentRevision?  @relation("ContractDocumentCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions       ContractDocumentRevision[] @relation("ContractDocumentRevisions")

  @@index([officeId, contractId])
  @@index([officeId, status])
  @@index([templateId])
  @@map("contract_documents")
}

/// 계약 문서의 불변 내용 스냅샷.
/// payload 와 contentHash 를 함께 승인 대상으로 사용해 검토한 버전과 실제 적용 버전의
/// 불일치를 막는다. createdBy 는 user UUID뿐 아니라 mcp:Codex 같은 actor도 담을 수 있다.
model ContractDocumentRevision {
  id         String @id @default(uuid()) @db.Uuid
  officeId   String @map("office_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid

  revisionNo  Int       @map("revision_no")
  contentHash String    @map("content_hash") @db.VarChar(64)
  payload     Json      @db.JsonB
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  appliedBy   String?   @map("applied_by")
  appliedAt   DateTime? @map("applied_at")

  document           ContractDocument  @relation("ContractDocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument ContractDocument? @relation("ContractDocumentCurrentRevision")
  office             Office            @relation(fields: [officeId], references: [id])

  @@unique([documentId, revisionNo])
  @@index([officeId, documentId, createdAt])
  @@index([contentHash])
  @@map("contract_document_revisions")
}

model OfficePrintTemplate {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  /// contract_cover / receipt / ledger_print / settlement / office_notice
  type  String
  title String

  /// 적용 거래 유형. 비어 있으면 전체 적용.
  transactionTypes String[] @default([]) @map("transaction_types")

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  /// 표지, 영수증, 거래대장, 정산서 등 출력 옵션 JSON.
  data Json @default("{}") @db.JsonB

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  office    Office @relation(fields: [officeId], references: [id])
  createdBy User?  @relation("OfficePrintTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId, type, isActive])
  @@index([officeId, isDefault])
  @@map("office_print_templates")
}

model ContractClauseTemplate {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  /// contract_clause / special_terms_clause / confirmation_clause / office_notice
  type         String
  /// base_contract / standard_lease_contract / broker_explanation 등 문서 종류.
  contractKind String? @map("contract_kind")

  /// 적용 거래 유형. 비어 있으면 전체 적용.
  transactionTypes String[] @default([]) @map("transaction_types")

  title   String
  content String

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  office    Office @relation(fields: [officeId], references: [id])
  createdBy User?  @relation("ContractClauseTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId, type, isActive, sortOrder])
  @@index([officeId, contractKind])
  @@map("contract_clause_templates")
}

// ============================================================
// 거래 담당자 배정
// ============================================================

/// 거래에 참여한 직원별 역할. 정산은 별도 모듈에서 이 데이터 기반으로 계산.
model DealParticipant {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid // 담당 직원

  role             String // listing_agent, buying_agent, dual_agent, manager, assistant, closer
  side             String // seller, buyer, both — 어느 측 담당인지
  commissionAmount Int?      @map("commission_amount") // 배분 금액 (만원)
  commissionRate   Decimal?  @map("commission_rate") @db.Decimal // 배분 비율 (%)
  settlementStatus String    @default("unsettled") @map("settlement_status")
  settlementDate   DateTime? @map("settlement_date")

  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])
  deal   Deal   @relation(fields: [dealId], references: [id])
  user   User   @relation("DealParticipants", fields: [userId], references: [id])

  @@unique([dealId, userId, role])
  @@index([officeId, userId])
  @@map("deal_participants")
}
