// ============================================================
// 상담 (순수 메모, context FK로 맥락 구분)
// ============================================================

model Consultation {
  id          String @id @default(uuid()) @db.Uuid
  officeId    String @map("office_id") @db.Uuid
  contactId   String @map("contact_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  type        String // phone, visit, online
  content     String

  // 통화 녹음 연결 (nullable — 녹음 없는 상담도 있음)
  callRecordingId String? @map("call_recording_id") @db.Uuid

  // 컨텍스트 (어떤 맥락의 상담인지, 자동 연결)
  propertyId String? @map("property_id") @db.Uuid // 호실 맥락 (소유자/세입자 상담)
  listingId  String? @map("listing_id") @db.Uuid // 매물 맥락 (거래 상담)
  matchId    String? @map("match_id") @db.Uuid
  buyerReqId String? @map("buyer_req_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office           Office            @relation(fields: [officeId], references: [id])
  contact          Contact           @relation(fields: [contactId], references: [id])
  createdBy        User              @relation("ConsultationCreator", fields: [createdById], references: [id])
  callRecording    CallRecording?    @relation(fields: [callRecordingId], references: [id])
  property         Property?         @relation(fields: [propertyId], references: [id])
  listing          Listing?          @relation(fields: [listingId], references: [id])
  match            Match?            @relation(fields: [matchId], references: [id])
  buyerRequirement BuyerRequirement? @relation(fields: [buyerReqId], references: [id])
  tasks            Task[]

  @@index([officeId, contactId])
  @@index([officeId, propertyId])
  @@index([officeId, listingId])
  @@map("consultations")
}

// ============================================================
// 구매고객 희망조건
// ============================================================

model BuyerRequirement {
  id               String    @id @default(uuid()) @db.Uuid
  officeId         String    @map("office_id") @db.Uuid
  contactId        String    @map("contact_id") @db.Uuid
  status           String    @default("active") // active, matched, completed, inactive
  urgency          String    @default("normal") // urgent, normal, flexible
  transactionType  String?   @map("transaction_type")
  siteTypes        String[]  @map("site_types")
  priceMin         Int?      @map("price_min")
  priceMax         Int?      @map("price_max")
  depositMin       Int?      @map("deposit_min")
  depositMax       Int?      @map("deposit_max")
  monthlyRentMax   Int?      @map("monthly_rent_max")
  areaMin          Decimal?  @map("area_min") @db.Decimal
  areaMax          Decimal?  @map("area_max") @db.Decimal
  mustConditions   String[]  @map("must_conditions")
  preferConditions String[]  @map("prefer_conditions")
  moveInDate       DateTime? @map("move_in_date")
  assignedToId     String?   @map("assigned_to_id") @db.Uuid
  lastContactDate  DateTime? @map("last_contact_date")
  nextContactDate  DateTime? @map("next_contact_date")
  memo             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  office           Office                    @relation(fields: [officeId], references: [id])
  contact          Contact                   @relation(fields: [contactId], references: [id])
  assignedTo       User?                     @relation("AssignedAgent", fields: [assignedToId], references: [id])
  matches          Match[]
  consultations    Consultation[]
  preferredSites   BuyerRequirementSite[]
  preferredRegions BuyerRequirementRegion[]

  @@index([officeId, status])
  @@map("buyer_requirements")
}

/// 구매고객이 원하는 구체적 단지 (Site 참조)
model BuyerRequirementSite {
  id         String   @id @default(uuid()) @db.Uuid
  buyerReqId String   @map("buyer_req_id") @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  priority   Int?
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")

  buyerRequirement BuyerRequirement @relation(fields: [buyerReqId], references: [id], onDelete: Cascade)
  site             Site             @relation(fields: [siteId], references: [id])

  @@unique([buyerReqId, siteId])
  @@index([siteId])
  @@map("buyer_requirement_sites")
}

/// 구매고객이 원하는 지역 — 법정동 코드 기반.
/// province/district/ward 중 가장 구체적인 레벨을 원하는 만큼만 채운다.
/// 예: 강동구 전체 → districtCode="11740", wardCode=null
///     고덕동     → districtCode="11740", wardCode="1174010100"
model BuyerRequirementRegion {
  id           String   @id @default(uuid()) @db.Uuid
  buyerReqId   String   @map("buyer_req_id") @db.Uuid
  provinceCode String?  @map("province_code") @db.VarChar(2)
  districtCode String?  @map("district_code") @db.VarChar(5)
  wardCode     String?  @map("ward_code") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  buyerRequirement BuyerRequirement @relation(fields: [buyerReqId], references: [id], onDelete: Cascade)
  province         Province?        @relation(fields: [provinceCode], references: [code])
  district         District?        @relation(fields: [districtCode], references: [code])
  ward             Ward?            @relation(fields: [wardCode], references: [code])

  @@index([buyerReqId])
  @@index([wardCode])
  @@index([districtCode])
  @@map("buyer_requirement_regions")
}

// ============================================================
// 매칭 파이프라인
// ============================================================

model Match {
  id         String   @id @default(uuid()) @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  buyerReqId String   @map("buyer_req_id") @db.Uuid
  stage      String   @default("suggested") // MatchStage enum
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  office           Office           @relation(fields: [officeId], references: [id])
  listing          Listing          @relation(fields: [listingId], references: [id])
  buyerRequirement BuyerRequirement @relation(fields: [buyerReqId], references: [id])
  consultations    Consultation[]
  calendarEvents   CalendarEvent[]
  deals            Deal[]

  @@map("matches")
}

// ============================================================
// 거래 (Deal)
// 매물 × 고객 조합의 실제 거래 추적. Contract 없이도 자기완결적.
// 조건(가격/특약)은 협상 중 변동 가능하며 ActivityLog 로 이력이 남는다.
// ============================================================

model Deal {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  // ─── 매물/매칭 연결 ────────────────────────────────────────
  /// 우리 DB 의 매물. 공동중개 매수측(외부 매물)은 null 허용.
  listingId String? @map("listing_id") @db.Uuid
  /// 공동중개로 외부 매물에 매수측으로 붙었을 때 참조 (listingId 와 상호보완)
  externalListingId String? @map("external_listing_id") @db.Uuid
  /// 어느 매칭에서 전환됐는지 (실적/직원 분석용)
  matchId String? @map("match_id") @db.Uuid

  // ─── 파이프라인 ────────────────────────────────────────────
  /// selection → negotiating → preContract → contracted → settling → completed → closed
  /// `contracted` 이상 단계로 가려면 Contract 레코드가 반드시 존재해야 함
  /// (service layer 에서 강제).
  stage          String   @default("selection")
  stageChangedAt DateTime @default(now()) @map("stage_changed_at")

  /// 취소 여부 (stage 와 직교. 취소되면 stage 는 취소 시점 값으로 동결)
  isCancelled  Boolean   @default(false) @map("is_cancelled")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")
  /// buyer / seller / mutual / external
  cancelledBy  String?   @map("cancelled_by")

  // ─── 거래 당사자 (주 연락처, 공동명의는 Contract 단계에서) ───
  buyerContactId  String? @map("buyer_contact_id") @db.Uuid
  sellerContactId String? @map("seller_contact_id") @db.Uuid

  // ─── 현재 합의 조건 (변동 가능, ActivityLog 로 이력 추적) ───
  transactionType   String    @map("transaction_type") // sale / jeonse / monthly
  /// 합의된 거래가 — "이 거래의 총액" 단일 진실 (매매가 또는 전세금)
  agreedPrice       Int?      @map("agreed_price")
  /// 월세 보증금 (만원)
  agreedDeposit     Int?      @map("agreed_deposit")
  /// 월세 (만원)
  agreedMonthlyRent Int?      @map("agreed_monthly_rent")
  /// 합의된 입주/이전 희망일
  agreedMoveInDate  DateTime? @map("agreed_move_in_date")
  /// 계약서 전 구두 합의 특약 (Contract 생성 시 Contract.specialTerms 로 승격)
  specialTerms      String?   @map("special_terms")

  /// 가계약금이 계약금으로 승계됐는지. true 면 Contract.statedDeposit 에
  /// 금액은 기재되지만 DealPayment(kind='contract') 는 생성되지 않음.
  preContractCarriedOver Boolean @default(false) @map("pre_contract_carried_over")

  // ─── 수수료 요약 ──────────────────────────────────────────
  // 의도적으로 캐시 필드를 두지 않는다.
  // 원천: CommissionPayment + CommissionDistribution. Deal 1건당 payment 2~5행
  // 수준이라 include + 서버 유틸(computeDealCommissionSummary) 로 매 조회 시
  // 계산하는 것이 동기화 복잡도보다 싸다.

  // ─── 공동중개 ──────────────────────────────────────────────
  isJointBrokerage Boolean @default(false) @map("is_joint_brokerage")
  /// 주 파트너 사무소 (FK). 여러 파트너가 있을 수 있지만 대표 하나만 링크.
  /// 상세 분배는 CommissionDistribution 으로 표현.
  partnerBrokerId  String? @map("partner_broker_id") @db.Uuid
  /// 공동중개 시 우리 측이 seller 인지 buyer 인지 both 인지
  ourSide          String? @map("our_side")

  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office          Office           @relation(fields: [officeId], references: [id])
  listing         Listing?         @relation(fields: [listingId], references: [id])
  externalListing ExternalListing? @relation(fields: [externalListingId], references: [id])
  match           Match?           @relation(fields: [matchId], references: [id])
  buyerContact    Contact?         @relation("DealBuyer", fields: [buyerContactId], references: [id])
  sellerContact   Contact?         @relation("DealSeller", fields: [sellerContactId], references: [id])
  partnerBroker   PartnerBroker?   @relation(fields: [partnerBrokerId], references: [id])

  contract           Contract?
  payments           DealPayment[]
  participants       DealParticipant[]
  commissionPayments CommissionPayment[]
  calendarEvents     CalendarEvent[]
  proposals          Proposal[]

  @@index([officeId, stage])
  @@index([officeId, isCancelled, stage])
  @@index([listingId])
  @@index([matchId])
  @@index([partnerBrokerId])
  @@map("deals")
}

// ============================================================
// 거래 대금 스케줄 (DealPayment)
// 가계약금 / 계약금 / 중도금(여러 차수) / 잔금 / 환불을 row 단위로 추적.
// 실제 돈이 움직이는 이벤트만 생성. 계약서 상 명목 금액은 Contract.stated* 필드.
// ============================================================

model DealPayment {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid

  /// pre_contract / contract / interim / balance / refund
  kind String

  /// 중도금 1차/2차 구분용 (kind='interim'). 나머지 kind 는 1.
  sequence Int @default(1)

  /// 예정 금액 (만원)
  scheduledAmount Int       @map("scheduled_amount")
  /// 예정일
  scheduledDate   DateTime? @map("scheduled_date")

  /// 실제 입금 금액 (만원, 부분입금 시 scheduledAmount 보다 작음)
  paidAmount Int?      @map("paid_amount")
  /// 실제 입금일
  paidAt     DateTime? @map("paid_at")

  /// pending / partial / paid / overdue / cancelled
  status String @default("pending")

  /// 지급 방식: transfer / cash / check / other
  method      String?
  /// 입금 계좌 정보
  accountInfo String? @map("account_info")
  /// 입금자명 (본인 아닌 경우 확인용)
  payerName   String? @map("payer_name")

  /// 영수증/증빙 파일 URL (S3/R2)
  receiptUrl String? @map("receipt_url")

  memo String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, kind, sequence])
  @@index([officeId, status, scheduledDate]) // 캐시플로우 대시보드
  @@index([dealId, kind])
  @@map("deal_payments")
}

// ============================================================
// 계약서 (Contract, Deal 1:1)
// 본계약이 체결되면 생성. 계약서 작성 자체가 트리거이며, 계약금 입금과는
// 별개 이벤트다 (소액 월세·가계약금 승계·법인 거래 등 계약금 없는 케이스 존재).
// 실제 돈 흐름은 DealPayment, 계약서 문서의 명목 금액은 Contract.stated*.
// ============================================================

model Contract {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @unique @map("deal_id") @db.Uuid

  // 거래 유형 (계약서 기준)
  transactionType String @map("transaction_type") // sale / jeonse / monthly

  // 당사자 (계약서 기재자. Deal 의 당사자와 다를 수 있음 - 대리인 등)
  buyerContactId  String @map("buyer_contact_id") @db.Uuid
  sellerContactId String @map("seller_contact_id") @db.Uuid

  // ─── 계약서 상 총액 (Deal.agreedPrice 의 시점 스냅샷) ────────
  /// 계약서 맨 위에 찍히는 총 거래금액 (매매가/전세금, 만원)
  totalPrice Int @map("total_price")

  // ─── 계약서 상 명목 금액 (계약서 문구, 실제 입금은 DealPayment) ─
  /// 계약서상 계약금 (만원). "계약금 X원 계약과 동시 지급" 문구.
  statedDeposit        Int?      @map("stated_deposit")
  /// 계약서상 중도금 (만원)
  statedInterimPayment Int?      @map("stated_interim_payment")
  statedInterimDate    DateTime? @map("stated_interim_date")
  /// 계약서상 잔금 (만원)
  statedBalance        Int?      @map("stated_balance")
  statedBalanceDate    DateTime? @map("stated_balance_date")

  // 월세인 경우
  monthlyRent Int? @map("monthly_rent") // 계약서상 월세 (만원)

  // ─── 상태 ────────────────────────────────────────────────
  /// draft / signed / depositPaid / balancePaid / registered / cancelled
  status String @default("draft")

  // ─── 일정 ────────────────────────────────────────────────
  /// 계약일 (계약서 작성일)
  contractDate DateTime? @map("contract_date")
  /// 입주/이전일
  moveInDate   DateTime? @map("move_in_date")

  // 임대 기간 (전세/월세)
  leaseStartDate DateTime? @map("lease_start_date")
  leaseEndDate   DateTime? @map("lease_end_date")

  // ─── 계약서 내용 ──────────────────────────────────────────
  /// 특약사항 (Deal.specialTerms 에서 승격되거나 계약서 단계에서 추가)
  specialTerms String? @map("special_terms")

  /// 첨부파일 (계약서 PDF, 신분증 스캔 등) — S3/R2 URL
  attachments String[]

  memo String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office        Office     @relation(fields: [officeId], references: [id])
  deal          Deal       @relation(fields: [dealId], references: [id])
  buyerContact  Contact    @relation("ContractBuyer", fields: [buyerContactId], references: [id])
  sellerContact Contact    @relation("ContractSeller", fields: [sellerContactId], references: [id])
  proposals     Proposal[]

  @@index([officeId])
  @@index([officeId, status])
  @@map("contracts")
}

// ============================================================
// 거래 담당자 배정
// ============================================================

/// 거래에 참여한 직원별 역할. 정산은 별도 모듈에서 이 데이터 기반으로 계산.
model DealParticipant {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid // 담당 직원

  role             String // listing_agent, buying_agent, dual_agent, manager, assistant, closer
  side             String // seller, buyer, both — 어느 측 담당인지
  commissionAmount Int?      @map("commission_amount") // 배분 금액 (만원)
  commissionRate   Decimal?  @map("commission_rate") @db.Decimal // 배분 비율 (%)
  settlementStatus String    @default("unsettled") @map("settlement_status")
  settlementDate   DateTime? @map("settlement_date")

  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])
  deal   Deal   @relation(fields: [dealId], references: [id])
  user   User   @relation("DealParticipants", fields: [userId], references: [id])

  @@unique([dealId, userId, role])
  @@index([officeId, userId])
  @@map("deal_participants")
}
