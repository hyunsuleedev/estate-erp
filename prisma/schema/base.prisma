generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // 로컬 dev(native) + 운영 Docker(Alpine musl, ARM64 — EC2 t4g).
  // "native"는 이미지를 빌드하는 기계의 것이라, ARM64 이미지를 다른 구조의 기계에서 만들어도 엔진이 빠지지 않게 적어 둔다.
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, postgis]
}
