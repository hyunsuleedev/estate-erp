// ============================================================
// Property (사무소가 관리하는 부동산 단위)
// 소유자/세입자 정보의 앵커. 매물(Listing)과 독립적으로 존재.
// ============================================================

model Property {
  id       String  @id @default(uuid()) @db.Uuid
  officeId String  @map("office_id") @db.Uuid
  siteId   String  @map("site_id") @db.Uuid
  unitId   String? @map("unit_id") @db.Uuid // nullable (토지/단독은 null)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office           Office            @relation(fields: [officeId], references: [id])
  site             Site              @relation(fields: [siteId], references: [id])
  unit             Unit?             @relation(fields: [unitId], references: [id])
  propertyContacts PropertyContact[]
  tenants          Tenant[]
  listingIntakes   ListingIntake[]
  listings         Listing[]
  consultations    Consultation[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  publicDocuments  PublicDocument[]
  photos           PropertyPhoto[]

  @@unique([officeId, siteId, unitId])
  @@index([officeId])
  @@index([siteId])
  @@map("properties")
}

// ============================================================
// ListingIntake (의뢰/접수 단위)
// 같은 의뢰 안에서 매매/전세/월세 Listing을 여러 개 가질 수 있다.
// 점유/방문/권리/현장 메모처럼 거래 옵션에 공통으로 걸리는 정보의 앵커.
// ============================================================

model ListingIntake {
  id         String @id @default(uuid()) @db.Uuid
  officeId   String @map("office_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  requesterContactId String?  @map("requester_contact_id") @db.Uuid
  /// 의뢰 생명주기만 저장: open | hold | closed
  lifecycleStatus    String   @default("open") @map("lifecycle_status")
  lifecycleChangedAt DateTime @default(now()) @map("lifecycle_changed_at")
  /// 마지막 생명주기 전이 주체: "user" | "system:deal"
  lifecycleChangedBy String   @default("user") @map("lifecycle_changed_by")
  /// closed일 때 종결 사유: withdrawn | unavailable | deal_completed | superseded | other
  closedReason       String?  @map("closed_reason")

  receivedAt      DateTime  @default(now()) @map("received_at")
  /// 마지막 확인 시도 시각. no_answer도 포함한다.
  lastCheckedAt   DateTime? @map("last_checked_at")
  /// alive/price_changed로 실제 유효성을 확인한 마지막 시각.
  lastVerifiedAt  DateTime? @map("last_verified_at")
  /// alive | price_changed | unavailable | no_answer | pending
  lastCheckResult String?   @map("last_check_result")

  occupancyStatus          String?   @map("occupancy_status")
  viewingMemo              String?   @map("viewing_memo") @db.Text
  rightsMemo               String?   @map("rights_memo") @db.Text
  fieldMemo                String?   @map("field_memo") @db.Text
  isJointBrokerageRequired Boolean   @default(false) @map("is_joint_brokerage_required")
  jointBrokeragePartnerId  String?   @map("joint_brokerage_partner_id") @db.Uuid
  nextConfirmAt            DateTime? @map("next_confirm_at")
  memo                     String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office                Office          @relation(fields: [officeId], references: [id])
  property              Property        @relation(fields: [propertyId], references: [id])
  requesterContact      Contact?        @relation(fields: [requesterContactId], references: [id])
  jointBrokeragePartner PartnerBroker?  @relation("ListingIntakeJointBrokeragePartner", fields: [jointBrokeragePartnerId], references: [id])
  listings              Listing[]
  consultations         Consultation[]
  tasks                 Task[]
  calendarEvents        CalendarEvent[]
  @@index([officeId, receivedAt])
  @@index([officeId, lifecycleStatus, updatedAt])
  @@index([officeId, lifecycleStatus, lifecycleChangedAt])
  @@index([officeId, lastVerifiedAt])
  @@index([officeId, lastCheckResult, lastCheckedAt])
  @@index([propertyId])
  @@index([requesterContactId])
  @@index([jointBrokeragePartnerId])
  @@index([officeId, nextConfirmAt])
  @@index([nextConfirmAt])
  // "Property 당 닫히지 않은 의뢰 하나" 는 partial unique index 로 강제 (migration SQL):
  // CREATE UNIQUE INDEX listing_intakes_one_non_closed_per_property
  //   ON listing_intakes (office_id, property_id)
  //   WHERE lifecycle_status IN ('open', 'hold')
  @@map("listing_intakes")
}

// ============================================================
// Listing (매물 = 거래 정보)
// Property에서 파생. 하나의 Property에 여러 Listing 가능.
// (예: 같은 호실을 매매 + 전세로 동시에 내놓는 경우)
// ============================================================

model Listing {
  id                     String    @id @default(uuid()) @db.Uuid
  officeId               String    @map("office_id") @db.Uuid
  propertyId             String    @map("property_id") @db.Uuid
  intakeId               String    @map("intake_id") @db.Uuid
  transactionType        String    @map("transaction_type") // sale, jeonse, monthly
  price                  Int? // 매매가/전세가 (만원)
  deposit                Int? // 보증금 (만원, monthly일 때)
  monthlyRent            Int?      @map("monthly_rent") // 월세 (만원)
  maintenanceFee         Int?      @map("maintenance_fee") // 관리비 (만원)
  /// 관리비 포함 항목 slug: water, electricity, gas, internet, tv, cleaning, parking, heating
  maintenanceFeeIncludes String[]  @default([]) @map("maintenance_fee_includes")
  loanAmount             Int?      @map("loan_amount") // 융자금/근저당 설정액 (만원)
  premium                Int? // 상가 권리금 (만원)
  /// 내부 전용 메모 — 네트워크 공유/외부(MCP 조회 포함) 노출 절대 금지
  privateMemo            String?   @map("private_memo")
  moveInAvailableType    String?   @map("move_in_available_type") // immediate, date, range, negotiable, unknown
  moveInAvailableFrom    DateTime? @map("move_in_available_from")
  moveInAvailableTo      DateTime? @map("move_in_available_to")
  /// 이 거래 옵션만 일시 중단 ("전세만 잠깐 내림"). 의뢰 전체 보류는 lifecycleStatus = hold.
  isPaused               Boolean   @default(false) @map("is_paused")
  memo                   String?

  // 확인 상태는 ListingIntake의 확인 시각/결과에서 파생한다.
  // "이 옵션이 거래중/완료" 는 이 Listing을 점유한 Deal(배타 단계)에서 파생한다.
  // 공동중개 여부/파트너도 의뢰(ListingIntake) 소유 — Listing 에는 두지 않는다.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office   Office        @relation(fields: [officeId], references: [id])
  property Property      @relation(fields: [propertyId], references: [id])
  intake   ListingIntake @relation(fields: [intakeId], references: [id])

  matches        Match[]
  deals          Deal[]
  consultations  Consultation[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  priceHistories PriceHistory[]
  advertisements ListingAdvertisement[]
  // 공동 중개망
  networkSharedProperties NetworkSharedProperty[]

  @@unique([intakeId, transactionType])
  @@index([officeId, transactionType, intakeId])
  @@index([propertyId])
  @@index([intakeId])
  @@map("listings")
}

// ============================================================
// ListingAdvertisement (내 사무소의 CP 광고 원장)
// 이실장/부동산뱅크처럼 호실을 제공하는 CP에서 가져온 실제 광고를 기록한다.
// channel/externalAdId/url은 CP 기준이고, naver*는 CP가 제공한 내 광고 비교
// 식별값이다. 광고노트 ExternalListing과의 FK나 논리적 연결에는 사용하지 않는다.
// CP 동기화는 lastSyncedAt, 네이버 비교 확인은 lastCheckedAt으로 분리한다.
// CP는 현재 광고 중인 항목만 반환하므로 row 상태는 active/ended만 사용한다.
// 수집 실패는 AdvertisementSyncRun/Step에 기록하고 기존 광고 row를 변경하지 않는다.
// ============================================================

model ListingAdvertisement {
  id        String @id @default(uuid()) @db.Uuid
  officeId  String @map("office_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid

  channel String // CP사 slug: esiljang, budongsanbank 등
  status  String @default("active") // active, ended
  source  String @default("manual") // manual, cp_sync

  advertisedPrice       Int? @map("advertised_price")
  advertisedDeposit     Int? @map("advertised_deposit")
  advertisedMonthlyRent Int? @map("advertised_monthly_rent")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  url       String? // CP 광고 관리 URL
  memo      String?

  externalAdId  String?   @map("external_ad_id") // CP사 광고 ID
  naverArticleNo String?   @map("naver_article_no")
  naverUrl       String?   @map("naver_url")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastSyncedAt  DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office                   Office                    @relation(fields: [officeId], references: [id])
  listing                  Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  officeAdvertisementGroup OfficeAdvertisementGroup?
  agentActionRequests      AgentActionRequest[]

  @@index([officeId])
  @@index([listingId, status])
  @@index([officeId, channel, status])
  @@index([officeId, naverArticleNo])
  @@map("listing_advertisements")
}

// ============================================================
// 가격 변경 이력
// ============================================================

/// 매물 가격 변경 시 자동 기록. 규칙 엔진의 가격변동 감지에 활용.
model PriceHistory {
  id        String  @id @default(uuid()) @db.Uuid
  officeId  String  @map("office_id") @db.Uuid
  listingId String  @map("listing_id") @db.Uuid
  changedBy String? @map("changed_by") @db.Uuid // FK → User (변경자)

  // 변경 전 가격
  priceBefore       Int? @map("price_before")
  depositBefore     Int? @map("deposit_before")
  monthlyRentBefore Int? @map("monthly_rent_before")

  // 변경 후 가격
  priceAfter       Int? @map("price_after")
  depositAfter     Int? @map("deposit_after")
  monthlyRentAfter Int? @map("monthly_rent_after")

  reason    String? // 변경 사유 ("집주인 요청", "시세 반영" 등)
  createdAt DateTime @default(now()) @map("created_at")

  office  Office  @relation(fields: [officeId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  user    User?   @relation(fields: [changedBy], references: [id])

  @@index([listingId, createdAt])
  @@map("price_histories")
}
