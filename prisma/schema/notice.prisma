// ============================================================
// 공지사항 (Notice)
// ============================================================
//
// 에스테잇플로우가 **모든 사용자**에게 알리는 공지다. 사무소가 직원에게 돌리는 공지가 아니다.
// 그래서 다른 업무 데이터와 달리 office_id 가 없고, 사무소 격리 대상(TENANT_SCOPED_MODELS)에도
// 올리지 않는다. 모든 사무소의 모든 직원이 같은 목록을 본다.
//
// 올리고 고치는 것은 운영자(User.isPlatformAdmin)만 한다. 데스크톱 앱에는 올리는 화면을 두지
// 않는다 — 앱은 직원이 쓰는 화면이고, 운영 화면은 나중에 별도 사이트로 만든다. 그때까지는
// 서버 API(/notices/admin)로만 올린다.
//
// 직원에게 보이는 공지: published_at 이 지났고 expires_at 이 없거나 아직 오지 않은 것.
//
// DB 제약(마이그레이션): 제목이 비어 있지 않을 것, expires_at 이 published_at 보다 뒤일 것.

model Notice {
  id String @id @default(uuid()) @db.Uuid

  title      String
  /// 본문. 줄바꿈이 있는 일반 글이다 (HTML·마크다운이 아니다).
  body       String
  /// 필독. 목록에서 표시를 달고 안 읽은 필독을 먼저 보여 준다.
  isRequired Boolean @default(false) @map("is_required")

  /// 이 시각부터 직원에게 보인다. 앞날로 두면 예약 게시다.
  publishedAt DateTime  @default(now()) @map("published_at")
  /// 이 시각부터 보이지 않는다. 비어 있으면 계속 보인다.
  expiresAt   DateTime? @map("expires_at")

  /// 올린 운영자
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reads NoticeRead[]

  @@index([publishedAt])
  @@map("notices")
}

/// 누가 어느 공지를 읽었는지. 줄이 있으면 읽은 것이다.
/// 사람에게 딸린 기록이라 office_id 없이 user_id 로만 찾는다.
model NoticeRead {
  noticeId String   @map("notice_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation("NoticeReads", fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([userId])
  @@map("notice_reads")
}
