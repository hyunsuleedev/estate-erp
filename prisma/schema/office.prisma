// ============================================================
// 멀티테넌시 - 사무소 + 사용자/인증
// ============================================================

model Office {
  id           String  @id @default(uuid()) @db.Uuid
  name         String // 사무소명
  licenseNo    String? @map("license_no") // 중개업 등록번호
  ceoName      String? @map("ceo_name")
  phone        String?
  address      String?
  subscription String  @default("basic") // basic, pro, premium
  maxUsers     Int     @default(3) @map("max_users")
  isActive     Boolean @default(true) @map("is_active")

  // 수수료 배분 설정 (사장님이 세팅)
  // { "distributionType": "percentage"|"fixed"|"custom",
  //   "defaultAgentRate": 50,       // 기본 직원 배분율 (%)
  //   "listingAgentRate": 50,       // 매도측 담당 기본 배분율
  //   "buyingAgentRate": 50,        // 매수측 담당 기본 배분율
  //   "dualAgentRate": 70,          // 단독중개(양측 모두 담당) 배분율
  //   "managerRate": 10,            // 관리자 배분율
  //   "closerBonus": 0 }            // 마감 담당 보너스 (만원)
  commissionConfig Json? @map("commission_config") @db.JsonB

  // ─── AI 직원 설정 ──────────────────────────────────────────
  /// AI 직원(Rule Engine + Proposal 루프) 전체 on/off
  agentEnabled Boolean @default(true) @map("agent_enabled")

  /// Proposal 타입별 trust tier 오버라이드.
  /// 예: { "ad_takedown": "approval_required", "lease_renewal_notice": "auto" }
  /// 키가 없으면 Rule/Proposal의 기본값을 사용.
  agentTrustConfig Json @default("{}") @map("agent_trust_config") @db.JsonB

  /// MCP 권한의 역할별 기본값. User.mcpPermissions가 없을 때 fallback.
  /// 예: { "owner": { "listing_write": "execute", ... },
  ///       "manager": { "listing_write": "propose", ... },
  ///       "agent": { "listing_write": "propose", ... } }
  /// Phase 1: 필드만 존재, Phase 2에 실제 해석 로직 붙음.
  mcpPermissionDefaults Json @default("{}") @map("mcp_permission_defaults") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  officeSites       OfficeSite[]
  sites             Site[]
  dongs             Dong[]
  units             Unit[]
  contacts          Contact[]
  contactPhones     ContactPhone[]
  contactRelations  ContactRelation[]
  propertyContacts  PropertyContact[]
  tenants           Tenant[]
  properties        Property[]
  listingIntakes    ListingIntake[]
  listings          Listing[]
  listingAdvertisements ListingAdvertisement[]
  officeAdvertisementGroups OfficeAdvertisementGroup[]
  officeAdvertisements      OfficeAdvertisement[]
  tasks             Task[]
  consultations     Consultation[]
  buyerRequirements BuyerRequirement[]
  matches           Match[]
  deals             Deal[]
  dealPayments      DealPayment[]
  contracts         Contract[]
  contractDocumentTemplates ContractDocumentTemplate[]
  contractDocuments ContractDocument[]
  officePrintTemplates OfficePrintTemplate[]
  contractClauseTemplates ContractClauseTemplate[]
  dealParticipants  DealParticipant[]
  rules             Rule[]
  proposals         Proposal[]
  entityDrafts      EntityDraft[]
  entityDraftComments EntityDraftComment[]
  calendarEvents    CalendarEvent[]

  siteUnitTypes  SiteUnitType[]
  priceHistories PriceHistory[]
  activityLogs   ActivityLog[]
  notifications  Notification[]

  externalListings                ExternalListing[]
  externalListingGroups           ExternalListingGroup[]
  externalListingSnapshotSessions ExternalListingSnapshotSession[]

  // 재무
  commissionPayments      CommissionPayment[]
  commissionDistributions CommissionDistribution[]
  commissionAdjustments   CommissionAdjustment[]
  officeExpenseTemplates  OfficeExpenseTemplate[]

  // 공동중개 파트너 주소록
  partnerBrokers       PartnerBroker[] @relation("OfficePartnerBrokers")
  linkedFromPartners   PartnerBroker[] @relation("LinkedAsPartner")

  // 공적장부 / 사진
  publicDocuments PublicDocument[]
  propertyPhotos  PropertyPhoto[]

  // 통화 녹음
  callRecordings CallRecording[]

  // 공동 중개망
  createdRooms            NetworkRoom[]
  networkRoomMembers      NetworkRoomMember[]
  networkSharedProperties NetworkSharedProperty[]
  networkInquiriesFrom    NetworkInquiry[]
  networkMessages         NetworkMessage[]

  // 협력업체
  serviceVendors  ServiceVendor[]
  vendorFavorites OfficeVendorFavorite[]

  @@map("offices")
}

model User {
  id               String  @id @default(uuid()) @db.Uuid
  officeId         String? @map("office_id") @db.Uuid
  loginId          String  @unique @map("login_id") // 로그인 ID (owner/직원 모두 별도 아이디 사용 가능)
  email            String? // owner 필수, 직원 선택
  name             String
  phone            String?
  role             String  @default("agent") // owner, manager, agent
  isActive         Boolean @default(true) @map("is_active")

  /// 공인중개사 자격 구분: broker_owner(개업공인중개사) | broker_associate(소속공인중개사) | assistant(중개보조원)
  licenseType String? @map("license_type")
  /// 공인중개사 자격증 번호 또는 중개사무소 등록 번호
  licenseNo String? @map("license_no")

  /// Clerk user.id 매핑. Clerk session JWT의 sub(user_xxx)로 자체 User를 조회한다.
  /// 기존 사용자 전환을 위해 첫 Clerk 로그인 시 email이 일치하면 자동 연결한다.
  clerkId String? @unique @map("clerk_id")

  /// 마지막 로그인 시각 (audit, 비활성 계정 추적).
  lastLoginAt DateTime? @map("last_login_at")

  /// 플랫폼 운영자 여부. true인 사용자만 공용 업체(ServiceVendor with officeId = null)를
  /// 생성/수정/삭제할 수 있다. 승격은 API로 self-promote 불가 — 수동 SQL 또는
  /// 기존 platform_admin 만이 다른 사용자를 승격할 수 있다.
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")

  /// MCP 권한 사용자별 오버라이드. null이면 Office.mcpPermissionDefaults의
  /// role별 기본값을 사용한다. 예: { "listing_write": "execute", ... }
  /// Phase 1: 필드만 존재, Phase 2에 실제 해석 로직 붙음.
  mcpPermissions Json? @map("mcp_permissions") @db.JsonB

  /// MCP/외부 AI 연결용 장기 API 키 (1인 1키). JWT 대신 사용.
  apiKeyHash   String? @map("api_key_hash")
  apiKeyPrefix String? @map("api_key_prefix") @db.VarChar(12)

  // ─── 급여/수수료 배분 ──────────────────────────────────────
  /// fixed: 고정급만, mixed: 고정급+수수료, commission_only: 순수 수수료제
  payType        String   @default("mixed") @map("pay_type")
  /// 월 기본급 (만원). commission_only 이면 0 또는 null.
  baseSalary     Int?     @map("base_salary")
  /// 개인 수수료 배분율 (%). null 이면 Office.commissionConfig 기본값.
  commissionRate Decimal? @map("commission_rate") @db.Decimal

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office               Office?            @relation(fields: [officeId], references: [id])
  assignedRequirements BuyerRequirement[] @relation("AssignedAgent")
  assignedTasks        Task[]             @relation("TaskAssignee")
  createdTasks         Task[]             @relation("TaskCreator")
  assignedTaskRequests Task[]             @relation("TaskAssigner")
  consultations        Consultation[]     @relation("ConsultationCreator")
  calendarEvents       CalendarEvent[]

  priceHistories   PriceHistory[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  dealParticipants DealParticipant[] @relation("DealParticipants")

  // 수수료 조정 승인 워크플로우
  commissionAdjustmentsRequested CommissionAdjustment[] @relation("AdjustmentRequester")
  commissionAdjustmentsDecided   CommissionAdjustment[] @relation("AdjustmentDecider")

  // 통화 녹음
  callRecordings CallRecording[]

  // 공동 중개망
  networkSharedProperties NetworkSharedProperty[]
  networkInquiriesFrom    NetworkInquiry[]
  networkMessages         NetworkMessage[]

  // 공적장부
  requestedDocuments PublicDocument[] @relation("DocumentRequester")

  // 계약 문서 생성 이력
  generatedContractDocuments ContractDocument[] @relation("ContractDocumentGenerator")
  createdOfficePrintTemplates OfficePrintTemplate[] @relation("OfficePrintTemplateCreator")
  createdContractClauseTemplates ContractClauseTemplate[] @relation("ContractClauseTemplateCreator")

  // 외부 매물 스냅샷 세션
  externalListingSessionsStarted   ExternalListingSnapshotSession[] @relation("SnapshotSessionStartedBy")
  externalListingSessionsCompleted ExternalListingSnapshotSession[] @relation("SnapshotSessionCompletedBy")

  @@map("users")
}
