// ============================================================
// 수수료 청구 (CommissionPayment)
// ============================================================
//
// 한 Deal 에서 발생하는 "수수료 청구 건" 하나를 표현한다.
// (clientSide='seller' → 매도인에 청구, clientSide='buyer' → 매수인에 청구)
//
// 한 청구는 여러 사무소로 분배될 수 있다 → CommissionDistribution[] 참조.
// - 단독중개: 분배 1건 (우리 100%)
// - 공동중개 side-split: 각 청구를 한 사무소가 100% 가져감
// - 공동중개 pool-split: 한 청구를 여러 사무소가 비율대로 나눠 가짐
//
// 돈이 실제 이동하는 "거래 대금" (가계약금/계약금/중도금/잔금) 은 DealPayment
// 에서 추적하며, CommissionPayment 와는 다른 축이다. CommissionPayment 는
// 중개사↔고객 간 "수수료" 청구·수금 이벤트만 담당.

model CommissionPayment {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  dealId   String @map("deal_id") @db.Uuid

  /// 사람이 읽는 식별자 (예: "P-2604-01"). 자동 생성.
  code String?

  /// 청구 대상: seller | buyer
  /// "매도인에게 청구하는 돈인가 / 매수인에게 청구하는 돈인가"
  clientSide String @map("client_side")

  /// 실제로 누가 수금하는가: us | partner
  /// partner 일 때 원본 청구는 파트너 사무소가 받고, 우리는 distribution 으로만 몫 받음.
  collectedByOffice String @default("us") @map("collected_by_office")

  /// 지급자 연락처 (매도인/매수인)
  payerContactId String? @map("payer_contact_id") @db.Uuid

  // ─── 요율 계산 기록 (추후 감사/재계산용) ─────────────────────
  /// 요율 계산 기준 금액 (만원). 매매가 또는 환산가(월세: 보증금 + 월세×100).
  baseAmount Int?     @map("base_amount")
  /// 적용 요율 (%). 예: 0.4
  rate       Decimal? @db.Decimal

  // ─── 금액 (만원) ───────────────────────────────────────────
  /// 청구 확정 금액. baseAmount × rate 로 계산됐거나 수동 입력.
  expectedAmount Int  @map("expected_amount")
  /// 실제 수금 금액 (부분수금 시 expectedAmount 보다 작음).
  actualAmount   Int? @map("actual_amount")

  // ─── 일정 ────────────────────────────────────────────────
  /// 수금 예정일 (보통 Deal 잔금일)
  dueDate             DateTime? @map("due_date")
  /// 실제 입금일
  paidAt              DateTime? @map("paid_at")
  /// 일부수금 후 잔여 지급 약정일 (예: "1차 4/14 수금, 잔여 4/28 지급약정")
  agreedRemainingDate DateTime? @map("agreed_remaining_date")

  /// draft / pending / partial / collected / overdue / waived / cancelled
  /// - draft: Deal 협상 단계에 선생성된 시뮬레이션. 원장에서 숨김. contracted 전이 시 pending 으로 전환.
  /// - pending: 계약 확정 후 수금 대기
  status String @default("draft")

  /// cash | transfer | card
  method String?

  // ─── 세금계산서 ───────────────────────────────────────────
  /// none → issued → sent
  taxInvoiceStatus String    @default("none") @map("tax_invoice_status")
  taxInvoiceNo     String?   @map("tax_invoice_no")
  taxInvoiceDate   DateTime? @map("tax_invoice_date")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office       Office   @relation(fields: [officeId], references: [id])
  deal         Deal     @relation(fields: [dealId], references: [id])
  payerContact Contact? @relation("CommissionPayer", fields: [payerContactId], references: [id])

  distributions CommissionDistribution[]
  adjustments   CommissionAdjustment[]
  /// 입금 건별 기록. actualAmount·paidAt·method·status 는 이 기록에서 다시 계산한 값이다.
  receipts      CommissionReceipt[]

  @@index([officeId, status])
  @@index([officeId, dueDate])
  @@index([officeId, code])
  @@index([dealId])
  @@map("commission_payments")
}

// ============================================================
// 수수료 분배 (CommissionDistribution)
// ============================================================
//
// CommissionPayment 한 건을 "누가 얼마 가져가는지" 표현. 공동중개의 다양한
// 배분 실무 (side-split / pool-split / 비대칭 분배 / 소개비 등) 를 하나의
// 모델로 표현.
//
// 단독중개: row 1개 (recipientType='our_office', shareRatio=100)
// 공동중개 pool-split 반반: 같은 payment 에 row 2개
//   - (recipientType='our_office',    shareRatio=50)
//   - (recipientType='partner_broker', partnerBrokerId=..., shareRatio=50)
// 소개비: row 2개 (우리 90%, 파트너 10%)
//
// recipientType='our_office' 는 사무소 내부 몫. 이 금액은 다시 DealParticipant
// 에서 직원별로 배분됨 (2층 구조).

model CommissionDistribution {
  id        String @id @default(uuid()) @db.Uuid
  officeId  String @map("office_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  /// our_office | partner_broker
  recipientType   String  @map("recipient_type")
  /// recipientType='partner_broker' 일 때 FK.
  partnerBrokerId String? @map("partner_broker_id") @db.Uuid

  /// 이 청구 중 이 수취인이 가져가는 비율 (%). 같은 payment 의 ratio 합은 100.
  shareRatio  Decimal @map("share_ratio") @db.Decimal
  /// 캐시된 금액 (expectedAmount × shareRatio / 100). 실정산은 actualAmount 기반.
  shareAmount Int     @map("share_amount")

  /// pending (분배 예정) | settled (정산 완료 — 파트너에게 송금했거나 수취 완료)
  status         String    @default("pending")
  settledAt      DateTime? @map("settled_at")
  settlementMemo String?   @map("settlement_memo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office        Office            @relation(fields: [officeId], references: [id])
  payment       CommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  partnerBroker PartnerBroker?    @relation(fields: [partnerBrokerId], references: [id])

  @@index([officeId, status])
  @@index([paymentId])
  @@index([partnerBrokerId])
  @@map("commission_distributions")
}

// ============================================================
// 수수료 조정 (CommissionAdjustment)
// ============================================================
//
// 담당자가 수수료 할인·면제·대손 요청 → 사장님(owner) 승인·반려 워크플로우.
// 수금 원장 UI 의 "ADJ-001 할인 합의 -200만" 같은 항목이 여기에 해당.

model CommissionAdjustment {
  id        String @id @default(uuid()) @db.Uuid
  officeId  String @map("office_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  /// 사람이 읽는 식별자 (예: "ADJ-001"). 자동 생성.
  code String?

  /// discount | waive | bad_debt
  /// discount: 고객과 할인 합의 / waive: 면제(서비스) / bad_debt: 대손처리
  type String

  /// 조정 금액 (만원). 수수료를 깎는 방향이므로 보통 음수 저장.
  amount Int

  reason String

  /// requested → approved / rejected
  status String @default("requested")

  requestedById String    @map("requested_by_id") @db.Uuid
  requestedAt   DateTime  @default(now()) @map("requested_at")
  decidedById   String?   @map("decided_by_id") @db.Uuid
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office      Office            @relation(fields: [officeId], references: [id])
  payment     CommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User              @relation("AdjustmentRequester", fields: [requestedById], references: [id])
  decidedBy   User?             @relation("AdjustmentDecider", fields: [decidedById], references: [id])

  @@index([officeId, status])
  @@index([officeId, code])
  @@index([paymentId])
  @@map("commission_adjustments")
}

// ============================================================
// 사무소 고정비 템플릿 (OfficeExpenseTemplate)
// 한번 등록 → 매월 자동 반영 (대시보드 집계용)
// ============================================================

model OfficeExpenseTemplate {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  title         String // "네이버 부동산 광고", "사무실 임대료"
  /// rent | ad | telecom | insurance | association | supplies | vehicle | other
  category      String
  /// 금액 (만원)
  amount        Int
  /// monthly | quarterly | yearly
  frequency     String  @default("monthly")
  /// 매월 결제일 (1~31)
  dayOfMonth    Int?    @map("day_of_month")
  /// 세금 공제 가능 여부 (부가세 매입세액 공제)
  taxDeductible Boolean @default(false) @map("tax_deductible")

  isActive Boolean @default(true) @map("is_active")
  note     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, isActive])
  @@map("office_expense_templates")
}

// ============================================================
// 수수료 입금 기록 (CommissionReceipt)
// ============================================================
//
// 손님에게서 수수료가 들어온(또는 돌려준) 일 한 번이 한 줄이다. 계약 때 일부, 잔금 때
// 나머지를 받으면 두 줄이 된다. 직원 정산은 이 줄을 달별로 모아 계산한다.
//
// 금액은 **원** 단위다. 가격은 만원이 규칙이지만, 부가세 10%와 3.3% 공제를 계산해야 해서
// 만원으로는 담을 수 없다. amountWon 은 손님이 실제로 낸 돈(부가세 포함),
// supplyWon 은 거기서 부가세를 뺀 금액이고 직원과 나누는 기준이다.
//
// 고치지 않는다. 잘못 넣었으면 취소(voidedAt)하고 다시 넣는다. 정산에 들어간 줄
// (settlementId 가 있음)은 취소할 수 없고, 돌려준 돈은 kind='refund' 인 음수 줄로 남긴다.
// 그 음수 줄이 다음 정산에서 직원 몫을 깎는다.
//
// DB 제약(마이그레이션): amount_won <> 0, kind 와 부호 일치,
// (office_id, payment_id) → commission_payments(office_id, id) 조합 FK.

model CommissionReceipt {
  id        String @id @default(uuid()) @db.Uuid
  officeId  String @map("office_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  /// receipt (들어온 돈, 양수) | refund (돌려준 돈, 음수)
  kind       String   @default("receipt")
  /// 돈이 움직인 날 (시각 없이 날짜만 뜻이 있다)
  receivedAt DateTime @map("received_at")
  /// 실제로 오간 금액 (원, 부가세 포함). 환불은 음수.
  amountWon  Int      @map("amount_won")
  /// 부가세를 뺀 금액 (원). 직원과 나누는 기준.
  supplyWon  Int      @map("supply_won")
  /// cash | transfer | card | etc
  method     String?
  memo       String?

  createdById String?   @map("created_by_id") @db.Uuid
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id") @db.Uuid
  voidReason  String?   @map("void_reason")

  /// 이 줄이 들어간 확정 정산. 비어 있으면 아직 정산하지 않은 돈이다.
  settlementId String? @map("settlement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office     Office            @relation(fields: [officeId], references: [id])
  payment    CommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  settlement Settlement?       @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([officeId, receivedAt])
  @@index([paymentId])
  @@index([officeId, settlementId])
  @@map("commission_receipts")
}

// ============================================================
// 직원 정산 (Settlement / SettlementLine)
// ============================================================
//
// 한 달 치 직원 정산을 **확정**한 기록이다. 확정 전의 정산은 저장하지 않고 입금 기록에서
// 그때그때 계산해 보여 준다(SettlementService.preview). 확정하면 그때의 규칙·직원 조건·
// 금액을 그대로 굳혀 저장하므로, 뒤에 직원 몫이나 정산 시점 설정을 바꿔도 달라지지 않는다.
//
// 고정 규칙(설정이 아님): 부가세를 빼고 나눈다 / 공동중개 상대 몫을 먼저 뺀다 /
// 깎아 준 수수료는 실제 받은 돈을 나누므로 비율대로 부담한다 / 정산한 뒤 돌려준 돈은
// 다음 정산에서 뺀다 / 뺄 돈이 더 크면 다음 달로 넘긴다(carryOutWon).
//
// DB 제약(마이그레이션): (office_id, month) 유일, month 는 'YYYY-MM' 형식.

model Settlement {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  /// 'YYYY-MM'
  month    String @db.VarChar(7)

  /// 확정 당시의 정산 시점 설정: closed (잔금이 끝난 뒤) | received (돈이 들어온 달)
  timing String

  confirmedAt   DateTime @default(now()) @map("confirmed_at")
  confirmedById String?  @map("confirmed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office   Office              @relation(fields: [officeId], references: [id])
  lines    SettlementLine[]
  receipts CommissionReceipt[]

  @@unique([officeId, month])
  @@map("settlements")
}

/// 확정 정산의 직원 한 명 몫. 금액은 모두 원.
model SettlementLine {
  id           String @id @default(uuid()) @db.Uuid
  officeId     String @map("office_id") @db.Uuid
  settlementId String @map("settlement_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  // ─── 확정 당시의 직원 조건 ─────────────────────────────────
  /// freelancer | employee
  employmentType String  @map("employment_type")
  withholdTax    Boolean @map("withhold_tax")

  // ─── 금액 (원) ────────────────────────────────────────────
  /// 직원 몫을 곱하기 전, 이 직원에게 배분된 금액
  targetWon      Int @map("target_won")
  /// 거래에서 나온 직원 몫 (들어온 돈)
  shareWon       Int @map("share_won")
  /// 프리랜서의 기본급. 근로자는 급여에서 나가므로 0.
  baseWon        Int @default(0) @map("base_won")
  /// 돌려준 돈 때문에 빼는 몫 (0 이하)
  adjustWon      Int @default(0) @map("adjust_won")
  /// 지난 정산에서 다 못 빼고 넘어온 돈 (0 이상)
  carryInWon     Int @default(0) @map("carry_in_won")
  /// 3.3% 공제액. 근로자와 공제를 끈 프리랜서는 0.
  withholdingWon Int @default(0) @map("withholding_won")
  /// 프리랜서: 이체할 금액 / 근로자: 세금 떼기 전 성과급
  netWon         Int @map("net_won")
  /// 이번에도 다 못 빼 다음 달로 넘기는 돈 (0 이상)
  carryOutWon    Int @default(0) @map("carry_out_won")

  /// 거래별 계산 근거 (화면 표시용). [{ dealId, title, receivedAt, amountWon, supplyWon, ourRatio, sharePercent, ratio, shareWon }]
  detail Json @db.JsonB

  /// 프리랜서: 지급한 날 / 근로자: 급여에 넘긴 날
  paidAt   DateTime? @map("paid_at")
  paidById String?   @map("paid_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  office     Office     @relation(fields: [officeId], references: [id])
  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  user       User       @relation("SettlementLines", fields: [userId], references: [id])

  @@unique([settlementId, userId])
  @@index([officeId, userId])
  @@map("settlement_lines")
}
