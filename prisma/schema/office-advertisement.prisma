// ============================================================
// OfficeAdvertisement (내 광고의 네이버 비교 스냅샷)
// ============================================================
//
// ListingAdvertisement가 이미 정확한 Listing/Property/Unit을 확정한다.
// 이 모델은 해당 광고의 네이버 노출 순위와 중복 광고만 저장하며,
// 독립적인 호실 힌트/연결/제외 상태를 갖지 않는다.

model OfficeAdvertisementGroup {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid

  listingAdvertisementId String @unique @map("listing_advertisement_id") @db.Uuid

  // CP가 제공한 ListingAdvertisement.naverArticleNo와 일치하는 내 네이버 광고.
  // 광고노트 ExternalListing을 조회하거나 연결해서 정하지 않는다.
  mainAdvertisementId String? @unique @map("main_advertisement_id") @db.Uuid

  memo String? @db.Text

  ownPrice        Int? @map("own_price")
  ownDeposit      Int? @map("own_deposit")
  ownMonthlyRent  Int? @map("own_monthly_rent")
  relatedPriceMin Int? @map("related_price_min")
  relatedPriceMax Int? @map("related_price_max")
  relatedCount    Int  @default(0) @map("related_count")

  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  office               Office                @relation(fields: [officeId], references: [id])
  listingAdvertisement ListingAdvertisement  @relation(fields: [listingAdvertisementId], references: [id], onDelete: Cascade)
  mainAdvertisement    OfficeAdvertisement?  @relation("OfficeAdvertisementGroupMain", fields: [mainAdvertisementId], references: [id])
  advertisements       OfficeAdvertisement[] @relation("OfficeAdvertisementGroupAdvertisements")

  @@index([officeId, lastSeenAt])
  @@map("office_advertisement_groups")
}

model OfficeAdvertisement {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @map("office_id") @db.Uuid
  groupId  String @map("group_id") @db.Uuid

  articleNo      String  @map("article_no")
  sourceUrl      String? @map("source_url")

  isMine   Boolean @default(false) @map("is_mine")
  isMain   Boolean @default(false) @map("is_main")
  isActive Boolean @default(true) @map("is_active")

  articleName         String? @map("article_name")
  realtorName         String? @map("realtor_name")
  realtorId           String? @map("realtor_id")
  representativeTelNo String? @map("representative_tel_no")

  price             Int?
  deposit           Int?
  monthlyRent       Int?    @map("monthly_rent")
  ranking           Int?
  sameAddrCnt       Int?    @map("same_addr_cnt")
  articleConfirmYmd String? @map("article_confirm_ymd")
  // 네이버에 공개된 층 표현. 내부 Unit.floor와 별개다.
  // 예: "12/25" = 정확한 층, "저/25" = 구간만 노출.
  floorInfo         String? @map("floor_info")
  floorExposureMode String  @default("unknown") @map("floor_exposure_mode")
  verificationTypeCode String? @map("verification_type_code")

  seango Boolean @default(false)
  epju   Boolean @default(false)
  raw    Json?   @db.JsonB

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  office      Office                    @relation(fields: [officeId], references: [id])
  group       OfficeAdvertisementGroup  @relation("OfficeAdvertisementGroupAdvertisements", fields: [groupId], references: [id], onDelete: Cascade)
  mainOfGroup OfficeAdvertisementGroup? @relation("OfficeAdvertisementGroupMain")

  @@unique([officeId, articleNo])
  @@index([officeId, groupId])
  @@index([officeId, isMine])
  @@index([officeId, isActive])
  @@index([officeId, lastSeenAt])
  @@map("office_advertisements")
}
