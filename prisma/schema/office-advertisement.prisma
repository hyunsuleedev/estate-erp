// ============================================================
// 내 광고의 네이버 비교
// ============================================================
//
// 광고(ListingAdvertisement) 하나에 대해 네이버에서 같은 집으로 보이는 광고들을 담는다.
// 사용자의 에이전트가 내 광고 한 건의 목록을 통째로 넣고, 서버는 스스로 묶지 않는다.
//
//   AdvertisementComparison        지금 네이버에 보이는 광고들 (내 것 + 경쟁). 읽을 때마다 덮어쓴다.
//   AdvertisementComparisonRecord  읽을 때마다의 요약 한 줄. 쌓이고 고치지 않는다 (순위 · 최저가의 흐름, 알림).
//
// 묶음 표(OfficeAdvertisementGroup)는 2026-11-18에 없앴다. 광고에 1:1로 붙어 요약을 복사해 두던 표라
// 과거가 남지 않았고, 묶는 열쇠는 처음부터 내 광고 ID였다.

/// 지금 네이버에 보이는 광고 한 줄. 내 광고(advertisementId)의 비교 목록에 속한다.
model AdvertisementComparison {
  id              String @id @default(uuid()) @db.Uuid
  officeId        String @map("office_id") @db.Uuid
  advertisementId String @map("advertisement_id") @db.Uuid

  articleNo String  @map("article_no")
  sourceUrl String? @map("source_url")

  /// 우리 사무소의 광고인가. "바로 이 내 광고"는 articleNo가 광고의 naverArticleNo와 같은 줄이다
  isMine   Boolean @default(false) @map("is_mine")
  /// 가장 최근 목록에 있었나
  isActive Boolean @default(true) @map("is_active")

  articleName         String? @map("article_name")
  realtorName         String? @map("realtor_name")
  realtorId           String? @map("realtor_id")
  representativeTelNo String? @map("representative_tel_no")

  price       Int?
  deposit     Int?
  monthlyRent Int? @map("monthly_rent")

  ranking           Int?
  sameAddrCnt       Int?    @map("same_addr_cnt")
  articleConfirmYmd String? @map("article_confirm_ymd")

  // 네이버에 공개된 층 표현. 내부 Unit.floor와 별개다.
  // 예: "12/25" = 정확한 층, "저/25" = 구간만 노출.
  floorInfo            String? @map("floor_info")
  floorExposureMode    String  @default("unknown") @map("floor_exposure_mode")
  verificationTypeCode String? @map("verification_type_code")

  seango Boolean @default(false)
  epju   Boolean @default(false)
  raw    Json?   @db.JsonB

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  office        Office               @relation(fields: [officeId], references: [id])
  advertisement ListingAdvertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  // 같은 집에 내 광고가 둘이면 경쟁 광고 한 건이 양쪽 비교에 모두 들어간다
  @@unique([advertisementId, articleNo])
  @@index([officeId, isMine])
  @@index([officeId, isActive])
  @@index([officeId, lastSeenAt])
  @@map("advertisement_comparisons")
}

/// 비교를 읽을 때마다의 시장 상태 한 줄. 경쟁 광고 줄 하나하나가 아니라 요약만 남긴다.
/// 화면의 "경쟁 대비"는 이 표가 아니라 최신 비교 줄과 마지막 네이버 수집 당시 가격(ownAdvertisement)으로
/// 계산한다(ownAdvertisement가 없을 때만 advertised* 사용). 이 표는 그때 본 것의 기록이다.
model AdvertisementComparisonRecord {
  id              String   @id @default(uuid()) @db.Uuid
  officeId        String   @map("office_id") @db.Uuid
  advertisementId String   @map("advertisement_id") @db.Uuid
  observedAt      DateTime @map("observed_at")

  /// 내 광고가 네이버 목록에 게재 중으로 보였나
  ownVisible     Boolean @map("own_visible")
  ownRanking     Int?    @map("own_ranking")
  /// 같은 집으로 보이는 게재 중 광고 수 (내 것 포함)
  totalCount     Int     @map("total_count")
  /// 그때의 내 광고 가격 (만원)
  ownPrice       Int?    @map("own_price")
  ownDeposit     Int?    @map("own_deposit")
  ownMonthlyRent Int?    @map("own_monthly_rent")

  /// 경쟁 광고의 최저 주 금액 (매매가 또는 보증금, 만원)
  lowestCompetitorAmount    Int?   @map("lowest_competitor_amount")
  lowerPricedCount          Int    @default(0) @map("lower_priced_count")
  /// exact | band | unknown
  ownFloorExposure          String @default("unknown") @map("own_floor_exposure")
  exactFloorCompetitorCount Int    @default(0) @map("exact_floor_competitor_count")

  /// 그때의 판단 (shared의 analyzeAdvertisementComparison primarySignal)
  signal     String
  /// 직전 기록에서 달라진 것. 예: ["cheaper_appeared"]. 없으면 빈 목록
  changes    String[]  @default([])
  /// 요약 알림에 담아 보낸 시각. 비어 있으면 아직 알리지 않았다
  notifiedAt DateTime? @map("notified_at")

  createdAt DateTime @default(now()) @map("created_at")

  office        Office               @relation(fields: [officeId], references: [id])
  advertisement ListingAdvertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId, observedAt])
  @@index([officeId, observedAt])
  @@map("advertisement_comparison_records")
}
